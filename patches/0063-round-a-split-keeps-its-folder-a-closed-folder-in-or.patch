+// Stedding (folders, BACKLOG S-136): splitting two tabs of a folder keeps the
+// split in that folder, at the pivot tab's place. Gathered by strip index, a
+// folder's first and last slots resolve in its parent, so the tabs left the
+// folder and a folder they emptied went. The pivot's folder wins, as its
+// group does.
+TEST_F(TabStripModelTest, SplittingTwoTabsOfAFolderKeepsTheSplitThere) {
+  const auto split_home = [](tabs::TabInterface* pane) {
+    const tabs::TabCollection* const split = pane->GetParentCollection();
+    return split ? split->GetParentCollection() : nullptr;
+  };
+
+  // The whole folder, with a tab on each side.
+  PrepareTabs(tabstrip(), 4);
+  tabs::FolderTabCollection* const folder = tabstrip()->AddToNewFolder({1, 2});
+  ASSERT_TRUE(folder);
+  tabs::TabInterface* const left = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const right = tabstrip()->GetTabAtIndex(2);
+  tabs::TabInterface* const before = tabstrip()->GetTabAtIndex(0);
+  tabs::TabInterface* const after = tabstrip()->GetTabAtIndex(3);
+  tabstrip()->ActivateTabAt(1);
+  tabstrip()->AddToNewSplit({2}, split_tabs::SplitTabVisualData(),
+                            split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(left->IsSplit());
+  EXPECT_EQ(left->GetSplit(), right->GetSplit());
+  EXPECT_EQ(folder, split_home(left)) << "the split left its folder";
+  EXPECT_EQ(1, tabstrip()->GetIndexOfTab(left)) << "where the first tab was";
+  EXPECT_EQ(2, tabstrip()->GetIndexOfTab(right));
+  EXPECT_EQ(0, tabstrip()->GetIndexOfTab(before));
+  EXPECT_EQ(3, tabstrip()->GetIndexOfTab(after));
+  EXPECT_EQ(2u, folder->TabCountRecursive());
+  tabstrip()->CloseAllTabs();
+
+  // The last two of a larger folder.
+  PrepareTabs(tabstrip(), 3);
+  tabs::FolderTabCollection* const three =
+      tabstrip()->AddToNewFolder({0, 1, 2});
+  ASSERT_TRUE(three);
+  tabs::TabInterface* const stay = tabstrip()->GetTabAtIndex(0);
+  tabs::TabInterface* const tail_left = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const tail_right = tabstrip()->GetTabAtIndex(2);
+  tabstrip()->ActivateTabAt(1);
+  tabstrip()->AddToNewSplit({2}, split_tabs::SplitTabVisualData(),
+                            split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(tail_left->IsSplit());
+  EXPECT_EQ(three, split_home(tail_left));
+  EXPECT_EQ(tail_left->GetSplit(), tail_right->GetSplit());
+  EXPECT_EQ(three, stay->GetParentCollection());
+  EXPECT_EQ(0, tabstrip()->GetIndexOfTab(stay));
+  EXPECT_EQ(1, tabstrip()->GetIndexOfTab(tail_left));
+  tabstrip()->CloseAllTabs();
+
+  // A nested folder: the pair is the whole inner folder.
+  PrepareTabs(tabstrip(), 3);
+  tabs::FolderTabCollection* const outer =
+      tabstrip()->AddToNewFolder({0, 1, 2});
+  ASSERT_TRUE(outer);
+  tabs::FolderTabCollection* const inner =
+      tabstrip()->AddToNewFolder({0, 1}, outer);
+  ASSERT_TRUE(inner);
+  tabs::TabInterface* const nested_left = tabstrip()->GetTabAtIndex(0);
+  tabs::TabInterface* const nested_right = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const outer_tail = tabstrip()->GetTabAtIndex(2);
+  ASSERT_EQ(inner, nested_left->GetParentCollection());
+  tabstrip()->ActivateTabAt(0);
+  tabstrip()->AddToNewSplit({1}, split_tabs::SplitTabVisualData(),
+                            split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(nested_left->IsSplit());
+  EXPECT_EQ(inner, split_home(nested_left)) << "it stays in the inner folder";
+  EXPECT_EQ(nested_left->GetSplit(), nested_right->GetSplit());
+  EXPECT_EQ(outer, inner->GetParentCollection());
+  EXPECT_EQ(outer, outer_tail->GetParentCollection());
+  EXPECT_EQ(0, tabstrip()->GetIndexOfTab(nested_left));
+  tabstrip()->CloseAllTabs();
+
+  // The other tab is in another folder: it joins the pivot's, and the folder
+  // it emptied goes.
+  PrepareTabs(tabstrip(), 3);
+  tabs::FolderTabCollection* const pivot_folder =
+      tabstrip()->AddToNewFolder({0, 1});
+  ASSERT_TRUE(pivot_folder);
+  ASSERT_TRUE(tabstrip()->AddToNewFolder({2}));
+  tabs::TabInterface* const lead = tabstrip()->GetTabAtIndex(0);
+  tabs::TabInterface* const pivot = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const other = tabstrip()->GetTabAtIndex(2);
+  tabstrip()->ActivateTabAt(1);
+  tabstrip()->AddToNewSplit({2}, split_tabs::SplitTabVisualData(),
+                            split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(pivot->IsSplit());
+  EXPECT_EQ(pivot_folder, split_home(pivot));
+  EXPECT_EQ(pivot->GetSplit(), other->GetSplit());
+  EXPECT_EQ(pivot_folder, lead->GetParentCollection());
+  EXPECT_EQ(1, tabstrip()->GetIndexOfTab(pivot)) << "at the pivot's place";
+  EXPECT_EQ(3u, pivot_folder->TabCountRecursive());
+  const auto unpinned_children = [&]() -> size_t {
+    for (const tabs::Child& child :
+         tabstrip()->Root()->GetChildren()) {
+      if (const auto* held =
+              std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+          held && (*held)->type() == tabs::TabCollection::Type::UNPINNED) {
+        return (*held)->ChildCount();
+      }
+    }
+    return 0;
+  };
+  EXPECT_EQ(1u, unpinned_children()) << "the emptied folder stayed";
+  tabstrip()->CloseAllTabs();
+
+  // The other tab is in an earlier folder, behind a pinned tab: it joins the
+  // pivot's folder, and the folder it emptied goes.
+  PrepareTabs(tabstrip(), 4);
+  tabstrip()->SetTabPinned(0, true);
+  ASSERT_TRUE(tabstrip()->AddToNewFolder({1}));
+  tabs::FolderTabCollection* const home = tabstrip()->AddToNewFolder({2, 3});
+  ASSERT_TRUE(home);
+  tabs::TabInterface* const early = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const kept = tabstrip()->GetTabAtIndex(2);
+  tabs::TabInterface* const late_pivot = tabstrip()->GetTabAtIndex(3);
+  tabstrip()->ActivateTabAt(3);
+  tabstrip()->AddToNewSplit({1}, split_tabs::SplitTabVisualData(),
+                            split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(late_pivot->IsSplit());
+  EXPECT_EQ(late_pivot->GetSplit(), early->GetSplit());
+  EXPECT_EQ(home, split_home(late_pivot));
+  EXPECT_EQ(home, kept->GetParentCollection());
+  EXPECT_EQ(3u, home->TabCountRecursive());
+  EXPECT_EQ(1u, unpinned_children()) << "the emptied folder stayed";
+  EXPECT_TRUE(tabstrip()->IsTabPinned(0));
+  tabstrip()->CloseAllTabs();
+
+  // The pivot is outside the folder: the folder's tab leaves it, as a grouped
+  // tab leaves its group for an ungrouped pivot.
+  PrepareTabs(tabstrip(), 3);
+  ASSERT_TRUE(tabstrip()->AddToNewFolder({1, 2}));
+  tabs::TabInterface* const outside = tabstrip()->GetTabAtIndex(0);
+  tabs::TabInterface* const pulled = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const remains = tabstrip()->GetTabAtIndex(2);
+  tabstrip()->ActivateTabAt(0);
+  tabstrip()->AddToNewSplit({1}, split_tabs::SplitTabVisualData(),
+                            split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(outside->IsSplit());
+  EXPECT_EQ(outside->GetSplit(), pulled->GetSplit());
+  EXPECT_NE(tabs::TabCollection::Type::FOLDER, split_home(outside)->type());
+  EXPECT_EQ(tabs::TabCollection::Type::FOLDER,
+            remains->GetParentCollection()->type());
+  EXPECT_EQ(0, tabstrip()->GetIndexOfTab(outside));
+  tabstrip()->CloseAllTabs();
+}
