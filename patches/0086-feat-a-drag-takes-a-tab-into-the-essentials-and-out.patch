+void PinnedTabContainerView::SetEssentialsDropHighlight(bool highlighted) {
+  if (essentials_drop_highlighted_ == highlighted) {
+    return;
+  }
+  essentials_drop_highlighted_ = highlighted;
+  // The sidebar's own text colour, faint, as a folder's header is lit for a
+  // drop (folders F7).
+  const ui::ColorProvider* const provider = GetColorProvider();
+  if (!highlighted || !provider) {
+    SetBackground(nullptr);
+    return;
+  }
+  constexpr SkAlpha kDropHighlightAlpha = 0x2E;
+  SetBackground(views::CreateRoundedRectBackground(
+      SkColorSetA(provider->GetColor(kColorTabForegroundActiveFrameActive),
+                  kDropHighlightAlpha),
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius)));
+}
