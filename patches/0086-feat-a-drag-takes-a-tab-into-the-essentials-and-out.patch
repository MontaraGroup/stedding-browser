+// Stedding pins H27 (BACKLOG S-277, GitHub issue 16): where a tab dropped
+// becomes an essential, as in Arc: over the essentials, and the room above the
+// Space's title row, down to the list. Nothing outside the open sidebar.
+std::optional<gfx::Rect> EssentialsDropZone(TabStripView* strip) {
+  if (!strip || !base::FeatureList::IsEnabled(stedding::kArcStyleWindow)) {
+    return std::nullopt;
+  }
+  views::ScrollView* const list = strip->unpinned_tabs_scroll_view();
+  if (!list || !list->IsDrawn()) {
+    return std::nullopt;
+  }
+  int bottom = list->GetBoundsInScreen().y();
+  if (views::View* const title = strip->GetSpaceTitleRow();
+      title && title->IsDrawn()) {
+    bottom = std::min(bottom, title->GetBoundsInScreen().y());
+  }
+  const gfx::Rect bounds = strip->GetBoundsInScreen();
+  if (bottom <= bounds.y()) {
+    return std::nullopt;
+  }
+  return gfx::Rect(bounds.x(), bounds.y(), bounds.width(), bottom - bounds.y());
+}
+
+// Whether `point` is on the list's own rows, in its scroll view: a Space's
+// chip under the list, or the rows' room past it, is not the list.
+bool OnTheList(TabStripView* strip, const gfx::Point& point) {
+  views::ScrollView* const list =
+      strip ? strip->unpinned_tabs_scroll_view() : nullptr;
+  return list && list->IsDrawn() && list->GetBoundsInScreen().Contains(point);
+}
+
+// The essential whose card is under `point`, if one is.
+const tabs::TabInterface* EssentialAt(const PinnedTabContainerView* grid,
+                                      const gfx::Point& point) {
+  if (!grid) {
+    return nullptr;
+  }
+  for (const views::View* const child : grid->children()) {
+    const auto* const card = views::AsViewClass<TabView>(child);
+    if (card && card->IsDrawn() && card->GetBoundsInScreen().Contains(point)) {
+      return card->GetTabInterface();
+    }
+  }
+  return nullptr;
+}
+
+// Pins H27: dropped over the essentials, the dragged tabs become essentials,
+// before the card they were dropped on or after the last; dropped on the
+// list, dragged essentials leave the essentials for the place the bar showed,
+// and over the Clear line they are the Space's pins there.
+struct EssentialsMove {
+  bool into = false;
+  std::vector<tabs::TabHandle> tabs;
+  std::optional<tabs::TabHandle> before;
+  bool over_line = false;
+};
+
+void MoveAcrossTheEssentials(const EssentialsMove& move) {
+  for (const tabs::TabHandle& handle : move.tabs) {
+    tabs::TabInterface* const tab = handle.Get();
+    BrowserWindowInterface* const window =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    TabStripModel* const model = window ? window->GetTabStripModel() : nullptr;
+    if (!model || model->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+      continue;
+    }
+    tabs::TabInterface* const before =
+        move.before ? move.before->Get() : nullptr;
+    if (move.into) {
+      if (!tab->IsPinned()) {
+        model->SetTabPinned(model->GetIndexOfTab(tab), true);
+      }
+      if (!tab->IsPinned() || !before || before == tab || !before->IsPinned()) {
+        continue;
+      }
+    } else {
+      if (tab->IsPinned()) {
+        model->SetTabPinned(model->GetIndexOfTab(tab), false);
+      }
+      if (tab->IsPinned()) {
+        continue;
+      }
+    }
+    const int from = model->GetIndexOfTab(tab);
+    int to = before && model->GetIndexOfTab(before) != TabStripModel::kNoTab
+                 ? model->GetIndexOfTab(before)
+                 : model->count();
+    if (from < to) {
+      --to;
+    }
+    if (to != from) {
+      model->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+    }
+    if (!move.into && move.over_line) {
+      if (spaces::SpaceModel* const spaces = spaces::SpaceModel::From(window)) {
+        spaces->SetSpacePinnedInPlace(tab, true);
+      }
+    }
+  }
+}
