+namespace {
+// The first tab of a row of the list: the tab, a split's first pane, or a
+// folder's or a group's first tab.
+const tabs::TabInterface* FirstTabOfRow(const views::View& row) {
+  if (const auto* const tab = views::AsViewClass<TabView>(&row)) {
+    return tab->GetTabInterface();
+  }
+  if (const auto* const folder = views::AsViewClass<FolderView>(&row)) {
+    const std::vector<tabs::TabInterface*> tabs =
+        folder->folder() ? folder->folder()->GetTabsRecursive()
+                         : std::vector<tabs::TabInterface*>();
+    return tabs.empty() ? nullptr : tabs.front();
+  }
+  const TabCollectionNode* node = nullptr;
+  if (const auto* const split = views::AsViewClass<SplitTabView>(&row)) {
+    node = split->collection_node();
+  } else if (const auto* const group = views::AsViewClass<TabGroupView>(&row)) {
+    node = group->collection_node();
+  }
+  if (!node) {
+    return nullptr;
+  }
+  const tabs::ConstChildPtr data = node->GetNodeData();
+  if (const auto* const collection =
+          std::get_if<tabs::ConstDanglingUntriagedTabCollection>(&data)) {
+    return (*collection)->GetTabAtIndexRecursive(0);
+  }
+  return nullptr;
+}
+}  // namespace
+
+std::optional<UnpinnedTabContainerView::RowDropPlace>
+UnpinnedTabContainerView::RowDropPlaceAt(const gfx::Point& screen_point) const {
+  if (!collection_node_ || !IsDrawn()) {
+    return std::nullopt;
+  }
+  gfx::Point point = screen_point;
+  views::View::ConvertPointFromScreen(this, &point);
+  if (point.x() < 0 || point.x() >= width() || point.y() < 0) {
+    return std::nullopt;
+  }
+  RowDropPlace place;
+  const views::View* previous = nullptr;
+  for (views::View* const child : collection_node_->GetDirectChildren()) {
+    // Another Space's rows are not on screen, and take no drop.
+    if (!child->GetVisible() || child->bounds().IsEmpty()) {
+      continue;
+    }
+    if (point.y() < child->bounds().CenterPoint().y()) {
+      place.before = FirstTabOfRow(*child);
+      place.indicator_y = child->bounds().y() - 1;
+      break;
+    }
+    previous = child;
+  }
+  if (!place.before) {
+    place.indicator_y = previous ? previous->bounds().bottom() + 1 : 0;
+  }
+  if (boundary_clear_line_ && boundary_clear_line_->GetVisible()) {
+    place.over_line =
+        point.y() < boundary_clear_line_->bounds().CenterPoint().y();
+  }
+  return place;
+}
