+void TabDragHandlerImpl::UpdateEssentialsDropFeedback() {
+  auto* const strip = views::AsViewClass<TabStripView>(
+      tab_strip_region_view_->GetTabStripView());
+  PinnedTabContainerView* const grid =
+      strip ? strip->GetPinnedTabsContainer() : nullptr;
+  UnpinnedTabContainerView* const list =
+      strip ? strip->GetUnpinnedTabsContainer() : nullptr;
+  bool lit = false;
+  std::optional<int> bar;
+  if (drag_controller_ && last_drag_point_in_screen_ &&
+      drag_controller_->GetSessionData().dragging_groups.empty() &&
+      drag_controller_->GetSessionData().source_view_drag_data()) {
+    if (!drag_controller_->GetSessionData().source_view_drag_data()->pinned) {
+      const std::optional<gfx::Rect> zone = EssentialsDropZone(strip);
+      lit = zone && zone->Contains(*last_drag_point_in_screen_);
+    } else if (list && EssentialsDropZone(strip) &&
+               OnTheList(strip, *last_drag_point_in_screen_)) {
+      if (const std::optional<UnpinnedTabContainerView::RowDropPlace> place =
+              list->RowDropPlaceAt(*last_drag_point_in_screen_)) {
+        bar = place->indicator_y;
+      }
+    }
+  }
+  if (grid) {
+    grid->SetEssentialsDropHighlight(lit);
+  }
+  if (list && (bar || essentials_bar_shown_)) {
+    list->SetRowDropIndicator(bar);
+  }
+  essentials_bar_shown_ = bar.has_value();
+}
