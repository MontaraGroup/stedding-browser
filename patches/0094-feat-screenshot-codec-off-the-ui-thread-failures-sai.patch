diff --git a/chrome/browser/ui/stedding/screenshot/screenshot_codec.cc b/chrome/browser/ui/stedding/screenshot/screenshot_codec.cc
new file mode 100644
index 0000000000000..a27159ce8c9cd
--- /dev/null
+++ b/chrome/browser/ui/stedding/screenshot/screenshot_codec.cc
@@ -0,0 +1,136 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/screenshot/screenshot_codec.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/functional/callback.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/values.h"
+#include "chrome/browser/ui/stedding/screenshot/screenshot_file.h"
+#include "ui/gfx/codec/png_codec.h"
+
+namespace stedding {
+
+namespace {
+
+base::RepeatingClosure& CodecObserver() {
+  static base::NoDestructor<base::RepeatingClosure> observer;
+  return *observer;
+}
+
+// The start of every step: it must not be on the UI thread, and a test may be
+// counting where the steps run.
+void BeginStep() {
+  base::AssertLongCPUWorkAllowed();
+  if (!CodecObserver().is_null()) {
+    CodecObserver().Run();
+  }
+}
+
+CaptureReply ReadReply(std::string_view message, int request_id) {
+  CaptureReply reply;
+  const std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+  if (!parsed || parsed->FindInt("id") != request_id) {
+    return reply;  // an event, not our reply
+  }
+  reply.kind = ReplyKind::kNoPicture;
+  const base::DictValue* const result = parsed->FindDict("result");
+  const std::string* const data = result ? result->FindString("data") : nullptr;
+  if (!data) {
+    return reply;
+  }
+  std::optional<std::vector<uint8_t>> bytes = base::Base64Decode(*data);
+  if (bytes && !bytes->empty()) {
+    reply.kind = ReplyKind::kPicture;
+    reply.png = std::move(*bytes);
+  }
+  return reply;
+}
+
+CaptureOutcome WriteThenDecode(std::vector<uint8_t> png,
+                               const base::FilePath& directory,
+                               const base::FilePath& name) {
+  CaptureOutcome outcome;
+  if (png.empty()) {
+    return outcome;
+  }
+  // The file first: it is the page's own PNG, good even when this decoder
+  // cannot read it.
+  outcome.path = WriteNewScreenshotFile(directory, name, png);
+  outcome.bitmap = gfx::PNGCodec::Decode(png);
+  return outcome;
+}
+
+}  // namespace
+
+CaptureReply::CaptureReply() = default;
+CaptureReply::CaptureReply(CaptureReply&&) = default;
+CaptureReply& CaptureReply::operator=(CaptureReply&&) = default;
+CaptureReply::~CaptureReply() = default;
+
+CaptureOutcome::CaptureOutcome() = default;
+CaptureOutcome::CaptureOutcome(CaptureOutcome&&) = default;
+CaptureOutcome& CaptureOutcome::operator=(CaptureOutcome&&) = default;
+CaptureOutcome::~CaptureOutcome() = default;
+
+CaptureReply ReadCaptureReply(std::string_view message, int request_id) {
+  BeginStep();
+  return ReadReply(message, request_id);
+}
+
+CaptureOutcome EncodeAndWrite(SkBitmap bitmap,
+                              const base::FilePath& directory,
+                              const base::FilePath& name) {
+  BeginStep();
+  CaptureOutcome outcome;
+  if (bitmap.drawsNothing()) {
+    return outcome;
+  }
+  const std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                        /*discard_transparency=*/false);
+  if (png && !png->empty()) {
+    outcome.path = WriteNewScreenshotFile(directory, name, *png);
+  }
+  // Copied whether or not it was saved (screenshot C10).
+  outcome.bitmap = std::move(bitmap);
+  return outcome;
+}
+
+CaptureOutcome WriteAndDecode(std::vector<uint8_t> png,
+                              const base::FilePath& directory,
+                              const base::FilePath& name) {
+  BeginStep();
+  return WriteThenDecode(std::move(png), directory, name);
+}
+
+FullPageResult ReadWriteAndDecode(std::string message,
+                                  int request_id,
+                                  const base::FilePath& directory,
+                                  const base::FilePath& name) {
+  BeginStep();
+  FullPageResult result;
+  CaptureReply reply = ReadReply(message, request_id);
+  // The reply's text can be hundreds of megabytes; let it go before the
+  // decode makes the bitmap.
+  std::string().swap(message);
+  result.kind = reply.kind;
+  if (reply.kind == ReplyKind::kPicture) {
+    result.outcome = WriteThenDecode(std::move(reply.png), directory, name);
+  }
+  return result;
+}
+
+void SetCaptureCodecObserverForTesting(base::RepeatingClosure observer) {
+  CodecObserver() = std::move(observer);
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/screenshot/screenshot_codec.h b/chrome/browser/ui/stedding/screenshot/screenshot_codec.h
new file mode 100644
index 0000000000000..0906e57ff33af
--- /dev/null
+++ b/chrome/browser/ui/stedding/screenshot/screenshot_codec.h
@@ -0,0 +1,100 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_CODEC_H_
+#define CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_CODEC_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback_forward.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+
+namespace stedding {
+
+// The CPU-heavy and blocking steps of a capture (docs/features/screenshot.md
+// C9). Each runs as one task on the screenshot writer's sequence, never on the
+// UI thread: each starts with base::AssertLongCPUWorkAllowed(), which the
+// browser's UI thread forbids, so a DCHECK build flags a call made there.
+
+// What a DevTools message on the full-page capture's session turned out to be.
+enum class ReplyKind {
+  // An event, or a reply to another request: the capture keeps waiting.
+  kNotTheReply,
+  // The reply, with no picture in it: an error, no data, or data that is not
+  // base64.
+  kNoPicture,
+  // The reply, with the PNG's bytes.
+  kPicture,
+};
+
+struct CaptureReply {
+  CaptureReply();
+  CaptureReply(CaptureReply&&);
+  CaptureReply& operator=(CaptureReply&&);
+  ~CaptureReply();
+
+  ReplyKind kind = ReplyKind::kNotTheReply;
+  // Set only for kPicture.
+  std::vector<uint8_t> png;
+};
+
+// Reads `message`, a DevTools protocol message, as the reply to the
+// Page.captureScreenshot request numbered `request_id`: the JSON parse, the
+// id check and the base64 decode.
+CaptureReply ReadCaptureReply(std::string_view message, int request_id);
+
+// How a capture ended on the writer's sequence.
+struct CaptureOutcome {
+  CaptureOutcome();
+  CaptureOutcome(CaptureOutcome&&);
+  CaptureOutcome& operator=(CaptureOutcome&&);
+  ~CaptureOutcome();
+
+  // The picture, for the clipboard; draws nothing when there is none.
+  SkBitmap bitmap;
+  // The file written; empty when nothing was saved.
+  base::FilePath path;
+};
+
+// The visible and region captures: encodes `bitmap` as a PNG and writes it
+// into `directory` under `name` (WriteNewScreenshotFile, screenshot C4). The
+// bitmap comes back to be copied even when the encode or the write failed;
+// the path is set only when the file was saved. An empty bitmap gives an
+// empty outcome.
+CaptureOutcome EncodeAndWrite(SkBitmap bitmap,
+                              const base::FilePath& directory,
+                              const base::FilePath& name);
+
+// The full page: writes `png` as the page sent it, then decodes it for the
+// clipboard. A picture that does not decode is still saved and comes back
+// with nothing to copy; one that cannot be saved still comes back to be
+// copied.
+CaptureOutcome WriteAndDecode(std::vector<uint8_t> png,
+                              const base::FilePath& directory,
+                              const base::FilePath& name);
+
+// The full page's whole step, one task: ReadCaptureReply, then, when the
+// message is the reply and holds a picture, WriteAndDecode.
+struct FullPageResult {
+  ReplyKind kind = ReplyKind::kNotTheReply;
+  // Empty unless `kind` is kPicture.
+  CaptureOutcome outcome;
+};
+FullPageResult ReadWriteAndDecode(std::string message,
+                                  int request_id,
+                                  const base::FilePath& directory,
+                                  const base::FilePath& name);
+
+// Runs `observer` at the start of each step above, on the thread the step
+// runs on (screenshot C9). Tests only; a null callback clears it. Set it
+// before the capture starts and clear it only once the writer has drained.
+void SetCaptureCodecObserverForTesting(base::RepeatingClosure observer);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_CODEC_H_
