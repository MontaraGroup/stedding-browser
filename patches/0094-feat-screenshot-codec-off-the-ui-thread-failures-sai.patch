@@ -0,0 +1,295 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/screenshot/screenshot_codec.h"
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/json/values_util.h"
+#include "base/values.h"
+#include "chrome/browser/ui/stedding/screenshot/screenshot_capture.h"
+#include "chrome/browser/ui/toasts/api/toast_id.h"
+#include "chrome/browser/ui/toasts/toast_controller.h"
+#include "chrome/grit/generated_resources.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkRect.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/gfx/codec/png_codec.h"
+
+namespace stedding {
+namespace {
+
+constexpr int kRequestId = 1;
+
+const base::FilePath::CharType kName[] = FILE_PATH_LITERAL("Stedding page.png");
+
+// Two pixels wide and tall: red, with a blue top-left pixel, so a picture
+// that came back the wrong way round or not at all shows.
+SkBitmap TwoByTwo() {
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(2, 2);
+  bitmap.eraseColor(SK_ColorRED);
+  bitmap.erase(SK_ColorBLUE, SkIRect::MakeXYWH(0, 0, 1, 1));
+  return bitmap;
+}
+
+std::vector<uint8_t> TwoByTwoPng() {
+  std::optional<std::vector<uint8_t>> png = gfx::PNGCodec::EncodeBGRASkBitmap(
+      TwoByTwo(), /*discard_transparency=*/false);
+  EXPECT_TRUE(png);
+  return png.value_or(std::vector<uint8_t>());
+}
+
+void ExpectTwoByTwo(const SkBitmap& bitmap) {
+  ASSERT_EQ(2, bitmap.width());
+  ASSERT_EQ(2, bitmap.height());
+  EXPECT_EQ(SK_ColorBLUE, bitmap.getColor(0, 0));
+  EXPECT_EQ(SK_ColorRED, bitmap.getColor(1, 1));
+}
+
+std::vector<uint8_t> ReadBytes(const base::FilePath& path) {
+  return base::ReadFileToBytes(path).value_or(std::vector<uint8_t>());
+}
+
+std::string Reply(const std::vector<uint8_t>& png) {
+  return R"({"id":1,"result":{"data":")" + base::Base64Encode(png) + R"("}})";
+}
+
+class ScreenshotCodecTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  void TearDown() override {
+    SetCaptureCodecObserverForTesting(base::RepeatingClosure());
+  }
+
+  base::FilePath Downloads() const { return dir_.GetPath(); }
+
+  // A path where the Downloads folder cannot be made: a regular file is in
+  // the way.
+  base::FilePath NotAFolder() const {
+    const base::FilePath path = dir_.GetPath().AppendASCII("not a folder");
+    EXPECT_TRUE(base::WriteFile(path, "x"));
+    return path;
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+// screenshot C9: the DevTools reply is read off the UI thread, and only the
+// reply to its own request ends the capture.
+TEST_F(ScreenshotCodecTest, ReadsOnlyItsOwnReply) {
+  EXPECT_EQ(ReplyKind::kNotTheReply,
+            ReadCaptureReply(R"({"method":"Page.loadEventFired","params":{}})",
+                             kRequestId)
+                .kind)
+      << "an event";
+  EXPECT_EQ(ReplyKind::kNotTheReply,
+            ReadCaptureReply(R"({"id":2,"result":{"data":"AAAA"}})", kRequestId)
+                .kind)
+      << "another request's reply";
+  EXPECT_EQ(ReplyKind::kNotTheReply,
+            ReadCaptureReply("not JSON", kRequestId).kind);
+  EXPECT_EQ(ReplyKind::kNoPicture,
+            ReadCaptureReply(
+                R"({"id":1,"error":{"code":-32000,"message":"No target"}})",
+                kRequestId)
+                .kind)
+      << "an error";
+  EXPECT_EQ(ReplyKind::kNoPicture,
+            ReadCaptureReply(R"({"id":1,"result":{"data":"*not base64*"}})",
+                             kRequestId)
+                .kind);
+  EXPECT_EQ(ReplyKind::kNoPicture,
+            ReadCaptureReply(R"({"id":1,"result":{"data":""}})", kRequestId)
+                .kind)
+      << "no bytes";
+
+  const std::vector<uint8_t> png = TwoByTwoPng();
+  const CaptureReply reply = ReadCaptureReply(Reply(png), kRequestId);
+  EXPECT_EQ(ReplyKind::kPicture, reply.kind);
+  EXPECT_EQ(png, reply.png);
+}
+
+// screenshot C9, C10: a visible or region capture is encoded and saved off the
+// UI thread; a failed save still hands the picture back to be copied.
+TEST_F(ScreenshotCodecTest, EncodesAndWritesOrSaysWhichPartFailed) {
+  {
+    SCOPED_TRACE("encoded and saved");
+    const CaptureOutcome outcome =
+        EncodeAndWrite(TwoByTwo(), Downloads(), base::FilePath(kName));
+    ASSERT_FALSE(outcome.path.empty());
+    EXPECT_EQ(Downloads().Append(kName), outcome.path);
+    ExpectTwoByTwo(gfx::PNGCodec::Decode(ReadBytes(outcome.path)));
+    ExpectTwoByTwo(outcome.bitmap);
+  }
+  {
+    SCOPED_TRACE("nothing to encode");
+    const CaptureOutcome outcome =
+        EncodeAndWrite(SkBitmap(), Downloads(), base::FilePath(kName));
+    EXPECT_TRUE(outcome.path.empty());
+    EXPECT_TRUE(outcome.bitmap.drawsNothing());
+  }
+  {
+    SCOPED_TRACE("the folder cannot be made: copied, not saved");
+    const CaptureOutcome outcome =
+        EncodeAndWrite(TwoByTwo(), NotAFolder(), base::FilePath(kName));
+    EXPECT_TRUE(outcome.path.empty());
+    ExpectTwoByTwo(outcome.bitmap);
+  }
+}
+
+// screenshot C9, C10: a full page's PNG is saved as the page sent it, then
+// decoded for the clipboard; a PNG this decoder cannot read is still saved.
+TEST_F(ScreenshotCodecTest, WritesAndDecodesOrSavesWhatItCannotRead) {
+  {
+    SCOPED_TRACE("saved and decoded");
+    const std::vector<uint8_t> png = TwoByTwoPng();
+    const CaptureOutcome outcome =
+        WriteAndDecode(png, Downloads(), base::FilePath(kName));
+    ASSERT_FALSE(outcome.path.empty());
+    EXPECT_EQ(png, ReadBytes(outcome.path)) << "the page's own bytes";
+    ExpectTwoByTwo(outcome.bitmap);
+  }
+  {
+    SCOPED_TRACE("does not decode: saved, not copied");
+    const std::vector<uint8_t> garbage = {1, 2, 3, 4};
+    const CaptureOutcome outcome =
+        WriteAndDecode(garbage, Downloads(), base::FilePath(kName));
+    ASSERT_FALSE(outcome.path.empty());
+    EXPECT_EQ(garbage, ReadBytes(outcome.path));
+    EXPECT_TRUE(outcome.bitmap.drawsNothing());
+  }
+  {
+    SCOPED_TRACE("nothing at all");
+    const CaptureOutcome outcome =
+        WriteAndDecode({}, Downloads(), base::FilePath(kName));
+    EXPECT_TRUE(outcome.path.empty());
+    EXPECT_TRUE(outcome.bitmap.drawsNothing());
+  }
+  {
+    SCOPED_TRACE("the folder cannot be made: copied, not saved");
+    const CaptureOutcome outcome =
+        WriteAndDecode(TwoByTwoPng(), NotAFolder(), base::FilePath(kName));
+    EXPECT_TRUE(outcome.path.empty());
+    ExpectTwoByTwo(outcome.bitmap);
+  }
+}
+
+// screenshot C9: a full page's parse, write and decode are one step, and each
+// step tells the observer once.
+TEST_F(ScreenshotCodecTest, AFullPageIsOneStep) {
+  int steps = 0;
+  SetCaptureCodecObserverForTesting(
+      base::BindRepeating([](int* count) { ++*count; }, &steps));
+
+  const std::vector<uint8_t> png = TwoByTwoPng();
+  const FullPageResult picture = ReadWriteAndDecode(
+      Reply(png), kRequestId, Downloads(), base::FilePath(kName));
+  EXPECT_EQ(ReplyKind::kPicture, picture.kind);
+  ASSERT_FALSE(picture.outcome.path.empty());
+  EXPECT_EQ(png, ReadBytes(picture.outcome.path));
+  ExpectTwoByTwo(picture.outcome.bitmap);
+  EXPECT_EQ(1, steps);
+
+  const FullPageResult event =
+      ReadWriteAndDecode(R"({"method":"Inspector.detached","params":{}})",
+                         kRequestId, Downloads(), base::FilePath(kName));
+  EXPECT_EQ(ReplyKind::kNotTheReply, event.kind);
+  EXPECT_TRUE(event.outcome.path.empty());
+
+  const FullPageResult error = ReadWriteAndDecode(
+      R"({"id":1,"error":{"code":-32000,"message":"x"}})", kRequestId,
+      Downloads(), base::FilePath(kName));
+  EXPECT_EQ(ReplyKind::kNoPicture, error.kind);
+  EXPECT_TRUE(error.outcome.path.empty());
+  EXPECT_TRUE(error.outcome.bitmap.drawsNothing());
+  EXPECT_EQ(3, steps);
+  EXPECT_FALSE(base::PathExists(
+      Downloads().Append(base::FilePath(kName).InsertBeforeExtensionASCII(
+          " 2"))))
+      << "only the picture was saved";
+}
+
+// screenshot C5, C10, C11: the toast says what happened, and a saved
+// capture's toast carries its own file.
+TEST(ScreenshotToastTest, SaysWhatHappened) {
+  const base::FilePath path =
+      base::FilePath(FILE_PATH_LITERAL("downloads")).Append(kName);
+  {
+    SCOPED_TRACE("copied and saved");
+    const ToastParams params = CaptureToastParams(/*copied=*/true, path);
+    EXPECT_EQ(ToastId::kSteddingCaptureSaved, params.toast_id);
+    EXPECT_FALSE(params.body_string_override) << "Copied · Saved to Downloads";
+    ASSERT_TRUE(params.action_button_callback_data);
+    EXPECT_EQ(path, base::ValueToFilePath(*params.action_button_callback_data));
+  }
+  {
+    SCOPED_TRACE("saved, not copied");
+    const ToastParams params = CaptureToastParams(/*copied=*/false, path);
+    EXPECT_EQ(ToastId::kSteddingCaptureSaved, params.toast_id);
+    EXPECT_EQ(
+        l10n_util::GetStringUTF16(IDS_STEDDING_CAPTURE_NOT_COPIED_TOAST_BODY),
+        params.body_string_override);
+    ASSERT_TRUE(params.action_button_callback_data);
+    EXPECT_EQ(path, base::ValueToFilePath(*params.action_button_callback_data));
+  }
+  {
+    SCOPED_TRACE("copied, not saved");
+    const ToastParams params =
+        CaptureToastParams(/*copied=*/true, base::FilePath());
+    EXPECT_EQ(ToastId::kSteddingCaptureFailed, params.toast_id);
+    EXPECT_EQ(
+        l10n_util::GetStringUTF16(IDS_STEDDING_CAPTURE_NOT_SAVED_TOAST_BODY),
+        params.body_string_override);
+    EXPECT_FALSE(params.action_button_callback_data)
+        << "no button, so no data: ToastController CHECKs that they match";
+  }
+  {
+    SCOPED_TRACE("nothing");
+    const ToastParams params =
+        CaptureToastParams(/*copied=*/false, base::FilePath());
+    EXPECT_EQ(ToastId::kSteddingCaptureFailed, params.toast_id);
+    EXPECT_FALSE(params.body_string_override)
+        << "Couldn't take the screenshot";
+    EXPECT_FALSE(params.action_button_callback_data);
+  }
+}
+
+// screenshot C11: the button reveals the path in its own toast's data, and a
+// test can take that path instead of the system's file manager.
+TEST(ScreenshotToastTest, TheButtonRevealsItsOwnFile) {
+  const base::FilePath path =
+      base::FilePath(FILE_PATH_LITERAL("downloads")).Append(kName);
+  EXPECT_EQ(path, CapturePathToReveal(base::FilePathToValue(path)));
+  EXPECT_EQ(std::nullopt,
+            CapturePathToReveal(base::FilePathToValue(base::FilePath())));
+  EXPECT_EQ(std::nullopt, CapturePathToReveal(base::Value(3)));
+
+  std::vector<base::FilePath> revealed;
+  SetRevealCaptureForTesting(base::BindRepeating(
+      [](std::vector<base::FilePath>* into, const base::FilePath& taken) {
+        into->push_back(taken);
+      },
+      &revealed));
+  EXPECT_EQ(std::nullopt, CapturePathToReveal(base::FilePathToValue(path)))
+      << "the test took it";
+  SetRevealCaptureForTesting(
+      base::RepeatingCallback<void(const base::FilePath&)>());
+  EXPECT_EQ(std::vector<base::FilePath>({path}), revealed);
+}
