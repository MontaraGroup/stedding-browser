+  stedding::SetCaptureCodecObserverForTesting(base::BindRepeating(
+      [](std::atomic<int>* steps, std::atomic<int>* on_ui) {
+        ++*steps;
+        if (content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+          ++*on_ui;
+        }
