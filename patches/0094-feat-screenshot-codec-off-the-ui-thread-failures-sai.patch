+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kFullPage);
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kVisible);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return PngCount() == before + 2; }));
+  FlushCaptures();
+
+  EXPECT_GE(codec_steps_.load(), 2) << "one step per capture";
+  EXPECT_EQ(0, codec_steps_on_ui_.load()) << "a codec step ran on the UI thread";
