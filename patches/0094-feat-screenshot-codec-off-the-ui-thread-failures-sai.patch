+  // The later capture's button first, then the earlier one's: with one path
+  // for the whole browser, both would reveal the second window's file.
+  ASSERT_NO_FATAL_FAILURE(PressToastButton(second));
+  ASSERT_NO_FATAL_FAILURE(PressToastButton(browser()));
+  ASSERT_EQ(2u, revealed_.size());
+  EXPECT_NE(revealed_[0], revealed_[1]);
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  for (const base::FilePath& path : revealed_) {
+    EXPECT_EQ(downloads_.GetPath(), path.DirName()) << path;
+    EXPECT_TRUE(path.MatchesExtension(FILE_PATH_LITERAL(".png"))) << path;
+    EXPECT_TRUE(base::PathExists(path)) << path;
+  }
+}
+
+// screenshot C12: a little window (and a peek) has no toasts. Its capture is
+// still saved and copied, and asks for no toast it cannot show.
+IN_PROC_BROWSER_TEST_F(ScreenshotCaptureTest,
+                       ACaptureInALittleWindowIsSavedWithoutAToast) {
+  BrowserWindowInterface* const little =
+      CreateBrowserForPopup(browser()->GetProfile());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      little, embedded_test_server()->GetURL("/title1.html")));
+  EXPECT_FALSE(ToastController::From(little))
+      << "little windows have toasts now: show the capture's there";
+  ClearClipboard();
+  const int before = PngCount();
+  stedding::CaptureScreenshot(little, stedding::CaptureMode::kVisible);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return PngCount() == before + 1; }));
+  FlushCaptures();
+  EXPECT_FALSE(ClipboardPicture().drawsNothing());
+}
