+void SteddingSpacesHandler::HandleSetSpaceIsolatedAfterAsking(
+    const base::ListValue& args) {
+  if (args.size() != 2U) {
+    return;
+  }
+  AllowJavascript();
+  const std::optional<spaces::SpaceId> id = ParseId(args[0]);
+  if (!id || !args[1].is_bool()) {
+    return;
+  }
+  // The question counts the open pages and names the apps that keep the
+  // Space's session, and asks for them with no page open (web apps Wa13);
+  // the page asked about pages alone, so with only apps it turned the
+  // session off at once. The list follows the answer.
+  spaces::SetSpaceIsolatedAfterAsking(
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents()),
+      *id, args[1].GetBool());
