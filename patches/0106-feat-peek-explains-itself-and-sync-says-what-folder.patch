+        // Tresorit, pCloud and Resilio. Any folder works; these only name
+        // no note.
+        "Sync/Stedding", "Nextcloud/Stedding", "ownCloud/Stedding",
+        "MEGA/Stedding", "MEGAsync/Stedding", "Seafile/Stedding",
+        "SynologyDrive/Stedding", "Synology Drive/Stedding",
+        "Proton Drive/Stedding", "Tresorit/Stedding",
+        "pCloud Drive/Stedding", "Resilio Sync/Stedding"}) {
+    EXPECT_TRUE(LooksSynced(under(synced), home, {})) << synced;
+  }
+  EXPECT_TRUE(LooksSynced(base::FilePath(FILE_PATH_LITERAL("/Volumes/NAS/s")),
