+// P19: the first peeks carry a note saying what a peek is; it shows until it
+// is answered, and then never again.
+IN_PROC_BROWSER_TEST_F(PeekTest, TheFirstPeeksSayWhatAPeekIs) {
+  const GURL to = Url("b.test", "/title3.html");
+  ASSERT_NO_FATAL_FAILURE(OpenPin(to));
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  const auto peek_page = [&]() -> content::WebContents* {
+    ClickLink();
+    BrowserWindowInterface* const peek = WaitForPeek();
+    return peek ? peek->GetTabStripModel()->GetActiveWebContents() : nullptr;
+  };
+  const auto close_peek = [&]() {
+    stedding::PeekOver(browser())->GetWindow()->Close();
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return stedding::PeekOver(browser()) == nullptr; }));
+  };
+
+  content::WebContents* page = peek_page();
+  ASSERT_TRUE(page);
+  EXPECT_TRUE(stedding::HasPeekNoticeForTesting(page)) << "the first peek";
+  EXPECT_EQ(1, prefs->GetInteger(stedding::prefs::kPeekNoticeShown));
+  ASSERT_NO_FATAL_FAILURE(close_peek());
+
+  page = peek_page();
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(stedding::HasPeekNoticeForTesting(page))
+      << "closed unanswered, the note does not come back";
+  infobars::ContentInfoBarManager* const manager =
+      infobars::ContentInfoBarManager::FromWebContents(page);
+  ASSERT_TRUE(manager);
+  ASSERT_EQ(1u, manager->infobars().size());
+  infobars::InfoBar* const notice = manager->infobars()[0];
+  ASSERT_TRUE(notice->delegate()->AsConfirmInfoBarDelegate()->Accept());
+  notice->RemoveSelf();
+  EXPECT_TRUE(prefs->GetBoolean(stedding::prefs::kPeekNoticeAnswered));
+  ASSERT_NO_FATAL_FAILURE(close_peek());
+
+  page = peek_page();
+  ASSERT_TRUE(page);
+  EXPECT_FALSE(stedding::HasPeekNoticeForTesting(page)) << "answered, it came back";
+  EXPECT_EQ(2, prefs->GetInteger(stedding::prefs::kPeekNoticeShown));
 }
 
