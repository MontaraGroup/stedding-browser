+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace stedding {
+
+// docs/features/peek.md P19: a peek can come as a surprise to someone who
+// skipped the welcome flow, so the first peeks a profile opens carry a
+// one-line note at the top of the page -- what a peek is, that Open as Tab
+// keeps the page, and a link to the setting that turns peeks off or onto a
+// held press. It shows until it is answered, on at most
+// prefs::kPeekNoticeMaxShown peeks, and never again after.
+void MaybeShowPeekNotice(content::WebContents* page);
+
+// The page leaves its peek (Open as Tab, Open in Split View): that answers
+// the note, which is taken off the page so it does not follow it into the
+// window.
+void OnPeekPageKept(content::WebContents* page);
+
+// Whether `page` carries the note now (tests).
+bool HasPeekNoticeForTesting(content::WebContents* page);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_PEEK_NOTICE_H_
