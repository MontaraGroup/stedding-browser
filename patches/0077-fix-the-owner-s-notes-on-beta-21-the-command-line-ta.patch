+TabView* RootTabCollectionNode::RowOf(const tabs::TabInterface* tab) {
+  TabCollectionNode* const node =
+      tab ? GetNodeForHandle(tabs::TabCollectionNodeHandle(tab->GetHandle()))
+          : nullptr;
