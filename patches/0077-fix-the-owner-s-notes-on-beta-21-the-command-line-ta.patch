+      [&]() { return container->IsExtensionsMenuShowing(); }))
+      << "no extensions menu";
+  ExtensionsMenuView* const menu =
+      ExtensionsMenuView::GetExtensionsMenuViewForTesting();
+  ASSERT_TRUE(menu);
+  ExtensionMenuItemView* item = nullptr;
+  for (ExtensionMenuItemView* const entry :
+       menu->extensions_menu_items_for_testing()) {
+    if (entry->view_model()->GetId() == vault->id()) {
+      item = entry;
+    }
+  }
+  ASSERT_TRUE(item) << "the extension has no row in the menu";
+  views::test::ButtonTestApi(item->pin_button_for_testing())
+      .NotifyClick(ui::MouseEvent(ui::EventType::kMousePressed, gfx::Point(),
+                                  gfx::Point(), base::TimeTicks::Now(),
+                                  ui::EF_LEFT_MOUSE_BUTTON,
+                                  ui::EF_LEFT_MOUSE_BUTTON));
+  EXPECT_TRUE(ToolbarActionsModel::Get(browser()->GetProfile())
+                  ->IsActionPinned(vault->id()));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return shows(); }))
+      << "pinned from the open menu, the button never showed: "
+      << button->bounds().ToString() << ", drawn " << button->IsDrawn();
+  EXPECT_TRUE(base::test::RunUntil(red))
+      << "the pinned button never showed the extension's icon";
+
+  ExtensionsMenuView::Hide();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !container->IsExtensionsMenuShowing(); }));
+  EXPECT_TRUE(shows()) << "the button went with the menu";
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("site.test", "/title1.html")));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return shows() && red(); }))
+      << "the button went with the page";
+}
