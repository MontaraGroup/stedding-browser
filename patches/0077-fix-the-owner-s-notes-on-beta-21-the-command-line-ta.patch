+// The pale sand of the light window's ground.
+constexpr SkColor kSand = SkColorSetRGB(0xC8, 0xB3, 0x77);
+
+// The colours `supplier` gives a window whose ground is kSand.
+std::unique_ptr<ui::ColorProvider> OnTheSand(
+    ui::ColorProviderKey::InitializerSupplier* supplier) {
+  auto provider = std::make_unique<ui::ColorProvider>();
+  provider->AddMixer()[ui::kColorFrameActive] = {kSand};
+  ui::ColorProviderKey key;
+  key.color_mode = ui::ColorProviderKey::ColorMode::kLight;
+  supplier->AddColorMixers(provider.get(), key);
+  provider->GenerateColorMapForTesting();
+  return provider;
