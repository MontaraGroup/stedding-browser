+// http.server, whose accept queue of five the Mac overflows into resets) left
+// the tab on an error page, which a background tab does not reload. Here each
+// background tab's server answers only on the connection the tab opened
+// ahead, and the tabs' requests wait until the profile's certificate update,
+// sent as the launch sends it, has been through.
+class CommandLineTabsConnectedAheadTest : public InProcessBrowserTest {
+ public:
+  CommandLineTabsConnectedAheadTest() {
+    set_open_about_blank_on_browser_launch(false);
+  }
+
+ protected:
+  // The first tab is selected and loads before the test runs; the others are
+  // in the background, as on the Mac.
+  static constexpr std::string_view kHosts = "abcde";
+  static constexpr size_t kBackground = kHosts.size() - 1;
+
+  // A server of one background tab: it serves its page only on the first
+  // connection it accepts and hangs up on a request that comes on another.
+  class OneConnectionServer
+      : public net::test_server::EmbeddedTestServerConnectionListener {
+   public:
+    explicit OneConnectionServer(char host) : host_(host) {
+      server_.SetConnectionListener(this);
+      server_.RegisterRequestHandler(base::BindRepeating(
+          &OneConnectionServer::Handle, base::Unretained(this)));
+    }
+
+    net::EmbeddedTestServer& server() { return server_; }
+
+    int accepted() {
+      base::AutoLock lock(lock_);
+      return accepted_;
+    }
+
+    int refused() {
+      base::AutoLock lock(lock_);
+      return refused_;
+    }
+
+    // net::test_server::EmbeddedTestServerConnectionListener (on the
+    // server's thread, as Handle() is):
+    std::unique_ptr<net::StreamSocket> AcceptedSocket(
+        std::unique_ptr<net::StreamSocket> socket) override {
+      base::AutoLock lock(lock_);
+      if (++accepted_ == 1) {
+        first_ = socket.get();
+      }
+      return socket;
+    }
+    void ReadFromSocket(const net::StreamSocket& socket, int rv) override {
+      base::AutoLock lock(lock_);
+      last_read_ = &socket;
+    }
+
+   private:
+    std::unique_ptr<net::test_server::HttpResponse> Handle(
+        const net::test_server::HttpRequest& request) {
+      if (request.relative_url != "/page") {
+        return nullptr;
+      }
+      base::AutoLock lock(lock_);
+      if (last_read_ != first_) {
+        ++refused_;
+        // Closed without a byte: the request fails as one reset does.
+        return std::make_unique<net::test_server::RawHttpResponse>("", "");
+      }
+      auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+      response->set_content_type("text/html");
+      response->set_content("<title>Page " + std::string(1, host_) +
+                            "</title>Page");
+      return response;
+    }
+
+    const char host_;
+    net::EmbeddedTestServer server_;
+    base::Lock lock_;
+    int accepted_ GUARDED_BY(lock_) = 0;
+    int refused_ GUARDED_BY(lock_) = 0;
+    // Compared, never dereferenced.
+    raw_ptr<const net::StreamSocket, DisableDanglingPtrDetection> first_
+        GUARDED_BY(lock_) = nullptr;
+    raw_ptr<const net::StreamSocket, DisableDanglingPtrDetection> last_read_
+        GUARDED_BY(lock_) = nullptr;
+  };
+
+  // Holds a background tab's navigation before its request (after the
+  // navigation started, so after the tab connected ahead) until Release().
+  class HoldThrottle : public content::NavigationThrottle {
+   public:
+    explicit HoldThrottle(content::NavigationThrottleRegistry& registry)
+        : content::NavigationThrottle(registry) {}
+
+    ThrottleCheckResult WillStartRequest() override { return DEFER; }
+    const char* GetNameForLogging() override { return "HoldThrottle"; }
+
+    void Release() { Resume(); }
+
+    base::WeakPtr<HoldThrottle> GetWeakPtr() {
+      return weak_factory_.GetWeakPtr();
+    }
+
+   private:
+    base::WeakPtrFactory<HoldThrottle> weak_factory_{this};
+  };
+
+  // Records a tab's last main-frame navigation error, for the messages.
+  class ErrorRecorder : public content::WebContentsObserver {
+   public:
+    explicit ErrorRecorder(content::WebContents* contents)
+        : content::WebContentsObserver(contents) {}
+
+    void DidFinishNavigation(content::NavigationHandle* handle) override {
+      if (handle->IsInPrimaryMainFrame()) {
+        error_ = handle->GetNetErrorCode();
+      }
+    }
+
+    net::Error error() const { return error_; }
+
+   private:
+    net::Error error_ = net::OK;
+  };
+
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    ASSERT_TRUE(embedded_test_server()->InitializeAndListen());
+    for (const char host : kHosts.substr(1)) {
+      servers_.push_back(std::make_unique<OneConnectionServer>(host));
+      ASSERT_TRUE(servers_.back()->server().InitializeAndListen());
+    }
+    // As in CommandLineTabsTest.
+    command_line->AppendSwitchASCII(network::switches::kHostResolverRules,
+                                    "MAP *.test 127.0.0.1");
+    for (const char host : kHosts) {
+      command_line->AppendArg(Url(host).spec());
+    }
+  }
+
+  void SetUpInProcessBrowserTestFixture() override {
+    InProcessBrowserTest::SetUpInProcessBrowserTestFixture();
+    embedded_test_server()->StartAcceptingConnections();
+    for (auto& server : servers_) {
+      server->server().StartAcceptingConnections();
+    }
+    // Every tab the launch makes gets the hold for its navigation to a
+    // background tab's address.
+    creation_ = content::RegisterWebContentsCreationCallback(
+        base::BindRepeating(&CommandLineTabsConnectedAheadTest::Created,
+                            base::Unretained(this)));
+  }
+
+  void TearDownOnMainThread() override {
+    inserters_.clear();
+    recorders_.clear();
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  GURL Url(char host) {
+    if (host == kHosts[0]) {
+      return embedded_test_server()->GetURL("a.test", "/title2.html");
+    }
+    return servers_[kHosts.find(host) - 1]->server().GetURL(
+        std::string(1, host) + ".test", "/page");
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  std::string Describe() {
+    std::string out;
+    for (int i = 0; i < tabs()->count(); ++i) {
+      content::WebContents* const contents = tabs()->GetWebContentsAt(i);
+      content::RenderFrameHost* const frame = contents->GetPrimaryMainFrame();
+      std::string error;
+      for (const auto& recorder : recorders_) {
+        if (recorder->web_contents() == contents &&
+            recorder->error() != net::OK) {
+          error = " " + net::ErrorToShortString(recorder->error());
+        }
+      }
+      out += "\n  " + std::string(contents->GetVisibleURL().host()) +
+             (contents->IsLoading() ? " loading" : "") +
+             (frame->IsErrorDocument() ? " error-page" + error : "") +
+             " committed=" + frame->GetLastCommittedURL().spec() +
+             " title=" + base::UTF16ToUTF8(contents->GetTitle());
+    }
+    for (size_t i = 0; i < servers_.size(); ++i) {
+      out += "\n  server " + std::string(1, kHosts[i + 1]) +
+             ": accepted=" + base::NumberToString(servers_[i]->accepted()) +
+             " refused=" + base::NumberToString(servers_[i]->refused());
+    }
+    return out;
+  }
+
+  std::vector<std::unique_ptr<OneConnectionServer>> servers_;
+  std::vector<base::WeakPtr<HoldThrottle>> held_;
+
+ private:
+  void Created(content::WebContents* contents) {
+    recorders_.push_back(std::make_unique<ErrorRecorder>(contents));
+    inserters_.push_back(
+        std::make_unique<content::TestNavigationThrottleInserter>(
+            contents,
+            base::BindRepeating(&CommandLineTabsConnectedAheadTest::MaybeHold,
+                                base::Unretained(this))));
+  }
+
+  void MaybeHold(content::NavigationThrottleRegistry& registry) {
+    content::NavigationHandle& handle = registry.GetNavigationHandle();
+    const GURL& url = handle.GetURL();
+    if (!handle.IsInPrimaryMainFrame() || !url.SchemeIsHTTPOrHTTPS() ||
+        url.host() == "a.test" || !url.host().ends_with(".test")) {
+      return;
+    }
+    auto throttle = std::make_unique<HoldThrottle>(registry);
+    held_.push_back(throttle->GetWeakPtr());
+    registry.AddThrottle(std::move(throttle));
+  }
+
+  base::CallbackListSubscription creation_;
+  std::vector<std::unique_ptr<content::TestNavigationThrottleInserter>>
+      inserters_;
+  std::vector<std::unique_ptr<ErrorRecorder>> recorders_;
+};
+
+IN_PROC_BROWSER_TEST_F(CommandLineTabsConnectedAheadTest,
+                       ATabLoadsOverTheConnectionItOpenedAhead) {
+  ASSERT_EQ(static_cast<int>(kHosts.size()), tabs()->count()) << Describe();
+  // Each background tab is held before its request, and has connected ahead.
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    if (held_.size() != kBackground) {
+      return false;
+    }
+    for (auto& server : servers_) {
+      if (server->accepted() == 0) {
+        return false;
+      }
+    }
+    return true;
+  })) << "held " << held_.size() << " of" << Describe();
+
+  // The profile's certificate update, as the launch sends it, now. The
+  // network service hears of a change before the update is reported done,
+  // and has handled it once its interfaces are flushed.
+  Profile* const profile = browser()->GetProfile();
+  content::StoragePartition* const partition =
+      profile->GetDefaultStoragePartition();
+  base::test::TestFuture<void> updated;
+  partition->GetCertVerifierServiceUpdater()->WaitUntilNextUpdateForTesting(
+      updated.GetCallback());
+  ProfileNetworkContextServiceFactory::GetForContext(profile)
+      ->UpdateAdditionalCertificates();
+  ASSERT_TRUE(updated.Wait());
+  partition->FlushNetworkInterfaceForTesting();
+
+  for (base::WeakPtr<HoldThrottle>& throttle : held_) {
+    ASSERT_TRUE(throttle) << Describe();
+    throttle->Release();
+  }
+  for (const char host : kHosts.substr(1)) {
+    SCOPED_TRACE(host);
+    content::WebContents* const contents =
+        tabs()->GetWebContentsAt(static_cast<int>(kHosts.find(host)));
+    ASSERT_EQ(Url(host), contents->GetVisibleURL()) << Describe();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !contents->IsLoading() &&
+             !contents->GetPrimaryMainFrame()->GetLastCommittedURL().is_empty();
+    })) << Describe();
+    EXPECT_FALSE(contents->GetPrimaryMainFrame()->IsErrorDocument())
+        << "it showed an error page, of" << Describe();
+    EXPECT_EQ(u"Page " + base::ASCIIToUTF16(std::string(1, host)),
+              contents->GetTitle())
+        << Describe();
+  }
+  for (auto& server : servers_) {
+    EXPECT_EQ(0, server->refused()) << Describe();
+  }
+}
+
 }  // namespace
