+           inner.ToString(), " inner2 ", inner2.ToString(), " favicon ",
+           favicon.ToString()});
+    }
+  };
+  const auto measure = [&]() {
+    Measured m;
+    m.card = row(tabs[0]);
+    m.card2 = row(tabs[1]);
+    m.pin = row(tabs[2]);
+    m.pin2 = row(tabs[3]);
+    if (ClearTabsSeparator* const clear =
+            stedding::test::FindDrawnClearLine(widget->GetRootView())) {
+      m.clear = clear->GetBoundsInScreen();
+    }
+    m.plain = row(tabs[4]);
+    m.plain2 = row(tabs[5]);
+    if (FolderView* const view =
+            stedding::test::FindDrawnFolder(widget->GetRootView(), folder)) {
+      m.header = view->GetHeaderBoundsInScreen();
