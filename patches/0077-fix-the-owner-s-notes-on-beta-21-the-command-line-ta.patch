+// pins H19 with expand-on-hover on (sidebar Y11; Windows, beta 21): the
+// pointer resting on a rail row shows the row's card during the rail's pause,
+// before the sidebar opens over the page; once it has opened, the row under
+// the still pointer shows its card, and the next row the pointer enters shows
+// its own. The pause took a lock that hid every card until the sidebar had
+// opened, and then the row under the pointer heard nothing, as the pointer
+// had not moved: no rail row showed a card. The pointer's moves go through
+// the window's root view, as a person's do.
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest,
+                       ARailRowShowsItsCardBeforeAndAfterTheRailOpens) {
+  tabs::TabInterface* const first = OpenInBackground(Colour("2050d0"));
+  tabs::TabInterface* const second = OpenInBackground(Colour("d05020"));
+  sidebar()->SetExpandOnHoverEnabled(true);
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarHoverDelayMs, 2000);
+  ASSERT_NO_FATAL_FAILURE(CollapseTheSidebar(true));
+  VerticalTabStripRegionView* const region =
+      browser_view()->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(region);
+  // The test's word on the pointer stands in for the machine's real one
+  // (BACKLOG S-221).
+  region->SetHoveredForTesting(true);
+  views::View* const root = widget()->GetRootView();
+  const auto move_to = [&](const gfx::Point& screen_point) {
+    gfx::Point point = screen_point;
+    views::View::ConvertPointFromScreen(root, &point);
+    const ui::MouseEvent move(ui::EventType::kMouseMoved, point, point,
+                              ui::EventTimeForNow(), ui::EF_NONE, ui::EF_NONE);
+    root->OnMouseMoved(move);
+  };
+  const auto row_at = [&](const gfx::Point& screen_point) -> TabView* {
+    views::test::RunScheduledLayout(widget());
+    gfx::Point point = screen_point;
+    views::View::ConvertPointFromScreen(root, &point);
+    for (views::View* view = root->GetEventHandlerForPoint(point); view;
+         view = view->parent()) {
+      if (TabView* const row = views::AsViewClass<TabView>(view)) {
+        return row;
+      }
+    }
+    return nullptr;
+  };
+  const auto shows_the_card_of = [&](TabView* row) {
+    return row && cards()->IsHoverCardShowingForTab(row) && card() &&
+           card()->GetWidget() && card()->GetWidget()->IsVisible();
+  };
+
+  TabView* const rail_row = RowOf(first);
+  ASSERT_TRUE(rail_row);
