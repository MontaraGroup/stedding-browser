+// Asks the gate about each pane of a split while the model says the split
+// has left it.
+class AsksAsTheSplitLeaves : public TabStripModelObserver {
+ public:
+  void OnSplitTabChanged(const SplitTabChange& change) override {
+    if (change.type != SplitTabChange::Type::kRemoved) {
+      return;
+    }
+    for (const auto& [tab, index] : change.GetRemovedChange()->tabs()) {
+      kept_awake[tab] = SleepGateKeepsAwake(tab->GetContents());
+      in_use[tab] = TabIsInUse(tab);
+    }
+  }
+
+  std::map<tabs::TabInterface*, bool> kept_awake;
+  std::map<tabs::TabInterface*, bool> in_use;
+};
+
+// tabs R42: Chromium asks the gate about every page whenever one is shown or
+// hidden (on Windows), and a split dragged to another window hides a pane
+// while the model tells its observers the split has left. The panes still
+// name the split, which the model no longer holds, and asking about them
+// CHECKed in GetSplitData. Each answers for its own page then; back in a
+// window, a pane in use keeps its peer awake again.
+TEST_F(SleepTabsTest, ASplitLeavingTheWindowCanBeAskedAbout) {
+  OpenTab();
+  tabs::TabInterface* const left = OpenTab();
+  tabs::TabInterface* const right = OpenTab();
+  Split(right, left);
+  Page(left)->TestIncrementUsbActiveFrameCount();
+  ASSERT_TRUE(left->GetSplit());
+  const split_tabs::SplitTabId split = *left->GetSplit();
+
+  AsksAsTheSplitLeaves asks;
+  tabs().AddObserver(&asks);
+  std::unique_ptr<DetachedTabCollection> leaving =
+      tabs().DetachSplitTabForInsertion(split);
+  tabs().RemoveObserver(&asks);
+  ASSERT_EQ(2u, asks.kept_awake.size()) << "the observer was not told";
+  EXPECT_TRUE(asks.kept_awake[left]) << "the pane with the device";
+  EXPECT_TRUE(asks.in_use[left]);
+  EXPECT_FALSE(asks.kept_awake[right]) << "its own page is idle";
+  EXPECT_FALSE(asks.in_use[right]);
+
+  tabs().InsertDetachedSplitTabAt(std::move(leaving), tabs().count(),
+                                  /*pinned=*/false, std::nullopt);
+  ASSERT_TRUE(right->IsSplit());
+  Activate(tabs().GetTabAtIndex(0));
+  EXPECT_TRUE(TabIsInUse(right)) << "its peer's device keeps it awake";
+  EXPECT_TRUE(SleepGateKeepsAwake(right->GetContents()));
+  Page(left)->TestDecrementUsbActiveFrameCount();
+  EXPECT_FALSE(TabIsInUse(right));
 }
 
