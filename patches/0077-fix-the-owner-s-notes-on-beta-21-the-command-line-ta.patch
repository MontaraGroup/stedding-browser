diff --git a/chrome/test/stedding/window_top_browsertest.mm b/chrome/test/stedding/window_top_browsertest.mm
new file mode 100644
index 0000000000000..161ab30f52e72
--- /dev/null
+++ b/chrome/test/stedding/window_top_browsertest.mm
@@ -0,0 +1,340 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// sidebar Y29: every empty part of the window's top -- the sidebar's top row
+// around the traffic lights and the toggle, the gutter between the sidebar
+// and the address row, the address row between its buttons and the field's
+// empty start, and with the row hidden the strip above the page -- moves the
+// window when dragged and does what macOS's "Double-click a window's title
+// bar to" setting says when double-clicked, as Safari's and Chrome's tops do.
+// The owner double-clicked the top of the window and it sometimes did not
+// fill the screen (2026-10-20).
+
+#import <Cocoa/Cocoa.h>
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "chrome/browser/ui/views/tabs/vertical/vertical_tab_strip_top_container.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/sidebar_test_util.h"
+#include "content/public/test/browser_test.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/hit_test.h"
+#include "ui/display/display.h"
+#include "ui/display/screen.h"
+#include "ui/events/test/cocoa_test_event_utils.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+#include "ui/views/controls/button/button.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// A point of the window's top that should act as its title bar, and what it
+// is, for a failure message.
+struct Spot {
+  std::string what;
+  gfx::Point point;
+};
+
+class WindowTopTest : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("/title1.html")));
+    // A window smaller than the screen, in its work area, so it can zoom.
+    const gfx::Rect area =
+        display::Screen::Get()->GetPrimaryDisplay().work_area();
+    widget()->SetBounds(
+        gfx::Rect(area.x() + 40, area.y() + 40, 1200, 760));
+    stedding::test::KeepAboveOtherWindows(widget());
+    views::test::RunScheduledLayout(widget());
+    original_frame_ = window().frame;
+  }
+
+  void TearDownOnMainThread() override {
+    SetDoubleClickAction(nil);
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  BrowserView* view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* widget() { return view()->GetWidget(); }
+  NSWindow* window() { return widget()->GetNativeWindow().GetNativeNSWindow(); }
+
+  // The system setting, as the test binary's own value over the user's;
+  // nil takes that value away again.
+  void SetDoubleClickAction(NSString* action) {
+    NSUserDefaults* const defaults = [NSUserDefaults standardUserDefaults];
+    if (action) {
+      [defaults setObject:action forKey:@"AppleActionOnDoubleClick"];
+    } else {
+      [defaults removeObjectForKey:@"AppleActionOnDoubleClick"];
+    }
+  }
+
+  static gfx::Rect InWidget(const views::View* view) {
+    return view->ConvertRectToWidget(view->GetLocalBounds());
+  }
+
+  // The traffic lights, a DIP wider all round, in widget coordinates.
+  std::vector<gfx::Rect> Lights() {
+    std::vector<gfx::Rect> lights;
+    NSView* const content = window().contentView;
+    for (NSWindowButton kind :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      NSButton* const button = [window() standardWindowButton:kind];
+      if (!button || button.hidden) {
+        continue;
+      }
+      const NSRect frame = [button convertRect:button.bounds toView:nil];
+      gfx::Rect rect(NSMinX(frame), NSHeight(content.frame) - NSMaxY(frame),
+                     NSWidth(frame), NSHeight(frame));
+      rect.Outset(1);
+      lights.push_back(rect);
+    }
+    return lights;
+  }
+
+  // Every drawn button under `root`, a DIP wider all round, in widget
+  // coordinates.
+  static void CollectButtons(const views::View* root,
+                             std::vector<gfx::Rect>* out) {
+    for (const views::View* child : root->children()) {
+      if (!child->GetVisible() || child->bounds().IsEmpty()) {
+        continue;
+      }
+      if (views::IsViewClass<views::Button>(child)) {
+        gfx::Rect rect = InWidget(child);
+        rect.Outset(1);
+        out->push_back(rect);
+        continue;
+      }
+      CollectButtons(child, out);
+    }
+  }
+
+  static bool InAny(const std::vector<gfx::Rect>& rects,
+                    const gfx::Point& point) {
+    for (const gfx::Rect& rect : rects) {
+      if (rect.Contains(point)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // The empty parts of the window's top, each sampled along a line.
+  std::vector<Spot> EmptyTop() {
+    views::test::RunScheduledLayout(widget());
+    std::vector<Spot> spots;
+    std::vector<gfx::Rect> taken = Lights();
+    VerticalTabStripRegionView* const strip =
+        view()->vertical_tab_strip_region_view_for_testing();
+    const gfx::Rect sidebar = InWidget(strip);
+    VerticalTabStripTopContainer* const top =
+        strip->top_button_container_for_testing();
+    ToolbarView* const toolbar = view()->toolbar();
+    const bool row_shown = toolbar->IsDrawn();
+    CollectButtons(strip, &taken);
+    if (row_shown) {
+      CollectButtons(toolbar, &taken);
+    }
+
+    // The sidebar's top row, around the lights and the toggle, across the
+    // whole sidebar: its last DIPs lie past the top row's own view.
+    if (top->IsDrawn()) {
+      const gfx::Rect row = InWidget(top);
+      for (int x = sidebar.x() + 2; x < sidebar.right(); x += 4) {
+        const gfx::Point point(x, row.CenterPoint().y());
+        if (!InAny(taken, point)) {
+          spots.push_back({"the sidebar's top row", point});
+        }
+      }
+    }
+
+    const gfx::Rect card = InWidget(view()->contents_container());
+    if (row_shown) {
+      const gfx::Rect row = InWidget(toolbar);
+      // The gutter between the sidebar and the address row.
+      for (int x = sidebar.right(); x < row.x(); x += 2) {
+        spots.push_back({"the gutter beside the row",
+                         gfx::Point(x, row.CenterPoint().y())});
+      }
+      // The address row between its buttons, and the field's empty start:
+      // the field paints only from its chip on (toolbar T34).
+      LocationBarView* const bar = view()->GetLocationBarView();
+      const gfx::Rect field = InWidget(bar);
+      const std::optional<gfx::Rect>& band = bar->stedding_band_for_testing();
+      for (int x = row.x() + 2; x < row.right() - 2; x += 4) {
+        const gfx::Point point(x, row.CenterPoint().y());
+        if (InAny(taken, point)) {
+          continue;
+        }
+        if (field.Contains(point)) {
+          if (!band || x >= field.x() + band->x() - 2) {
+            continue;
+          }
+          spots.push_back({"the field's empty start", point});
+          continue;
+        }
+        spots.push_back({"the address row", point});
+      }
+      // The gutter after the row, to the window's edge.
+      for (int x = row.right(); x < widget()->GetRootView()->width() - 3;
+           x += 2) {
+        spots.push_back({"the gutter after the row",
+                         gfx::Point(x, row.CenterPoint().y())});
+      }
+      // Above the row, where the window's top margin is.
+      if (row.y() >= 6) {
+        for (int x = sidebar.right(); x < row.right(); x += 40) {
+          spots.push_back({"above the row", gfx::Point(x, row.y() / 2)});
+        }
+      }
+    } else if (card.y() >= 4) {
+      // The row hidden: the strip above the page.
+      for (int x = card.x(); x < card.right(); x += 20) {
+        const gfx::Point point(x, card.y() / 2);
+        if (!InAny(taken, point)) {
+          spots.push_back({"the strip above the page", point});
+        }
+      }
+    }
+    return spots;
+  }
+
+  // Every spot that is not the window's caption, described.
+  std::vector<std::string> NotCaption(const std::vector<Spot>& spots) {
+    std::vector<std::string> wrong;
+    for (const Spot& spot : spots) {
+      const int component = widget()->GetNonClientComponent(spot.point);
+      if (component != HTCAPTION) {
+        views::View* const under =
+            widget()->GetRootView()->GetEventHandlerForPoint(spot.point);
+        wrong.push_back(base::StrCat(
+            {spot.what, " at ", spot.point.ToString(), ": ",
+             base::NumberToString(component), " over ",
+             under ? under->GetClassName() : "nothing"}));
+      }
+    }
+    return wrong;
+  }
+
+  // A double click at `point`, as the window server delivers it: a press and
+  // a release, then a second pair with a click count of 2.
+  void DoubleClick(const gfx::Point& point) {
+    const NSPoint at = NSMakePoint(
+        point.x(), NSHeight(window().contentView.frame) - point.y());
+    for (const int count : {1, 2}) {
+      [window() sendEvent:cocoa_test_event_utils::MouseEventAtPointInWindow(
+                              at, NSEventTypeLeftMouseDown, window(), count)];
+      [window() sendEvent:cocoa_test_event_utils::MouseEventAtPointInWindow(
+                              at, NSEventTypeLeftMouseUp, window(), count)];
+    }
+  }
+
+  // Puts the window back where the fixture placed it.
+  [[nodiscard]] bool Restore() {
+    if (window().zoomed) {
+      [window() performZoom:nil];
+    }
+    [window() setFrame:original_frame_ display:YES];
+    return base::test::RunUntil([&] {
+      views::test::RunScheduledLayout(widget());
+      return !window().zoomed && NSEqualRects(window().frame, original_frame_);
+    });
+  }
+
+  // One spot of each kind: the one in the middle of its run.
+  static std::vector<Spot> OneOfEach(const std::vector<Spot>& spots) {
+    std::vector<Spot> picked;
+    for (size_t i = 0; i < spots.size();) {
+      size_t end = i;
+      while (end < spots.size() && spots[end].what == spots[i].what) {
+        ++end;
+      }
+      picked.push_back(spots[i + (end - i) / 2]);
+      i = end;
+    }
+    return picked;
+  }
+
+  // Double-clicks each spot with the setting at Zoom: the window zooms.
+  void ExpectEachZooms(const std::vector<Spot>& spots) {
+    SetDoubleClickAction(@"Maximize");
+    for (const Spot& spot : OneOfEach(spots)) {
+      SCOPED_TRACE(spot.what + " at " + spot.point.ToString());
+      ASSERT_FALSE(window().zoomed);
+      DoubleClick(spot.point);
+      EXPECT_TRUE(window().zoomed) << "a double click did not zoom";
+      ASSERT_TRUE(Restore());
+    }
+  }
+
+  NSRect original_frame_;
+};
+
+// sidebar Y29: with the sidebar open and the address row shown, every empty
+// part of the top is the window's title bar, and a double click on each kind
+// zooms the window. Over the title bar's band macOS reads the setting itself,
+// once, so the test's own value reaches only Chromium's part of the window.
+IN_PROC_BROWSER_TEST_F(WindowTopTest, EveryEmptyPartOfTheTopIsTheTitleBar) {
+  const std::vector<Spot> spots = EmptyTop();
+  ASSERT_FALSE(spots.empty());
+  for (const char* const kind :
+       {"the sidebar's top row", "the address row", "the field's empty start"}) {
+    EXPECT_TRUE(std::ranges::any_of(
+        spots, [&](const Spot& spot) { return spot.what == kind; }))
+        << "no spot in " << kind;
+  }
+  const std::vector<std::string> wrong = NotCaption(spots);
+  EXPECT_TRUE(wrong.empty()) << wrong.size() << " of " << spots.size()
+                             << " spots are not the title bar:\n"
+                             << base::JoinString(wrong, "\n");
+  ExpectEachZooms(spots);
+}
+
+// sidebar Y29: with the address row hidden (toolbar T10), the strip above the
+// page and the sidebar's top row are the title bar.
+IN_PROC_BROWSER_TEST_F(WindowTopTest, WithTheRowHiddenTheTopIsTheTitleBar) {
+  ASSERT_TRUE(
+      chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+  views::test::RunScheduledLayout(widget());
+  ASSERT_FALSE(view()->toolbar()->IsDrawn());
+  const std::vector<Spot> spots = EmptyTop();
+  EXPECT_TRUE(std::ranges::any_of(spots, [](const Spot& spot) {
+    return spot.what == "the strip above the page";
+  })) << "no strip above the page: the page starts at "
+     << InWidget(view()->contents_container()).y();
+  const std::vector<std::string> wrong = NotCaption(spots);
+  EXPECT_TRUE(wrong.empty()) << wrong.size() << " of " << spots.size()
+                             << " spots are not the title bar:\n"
+                             << base::JoinString(wrong, "\n");
+  ExpectEachZooms(spots);
+}
+
+}  // namespace
