+// InkCentringShift for a label a layout places at `label_bounds` in a parent
+// `parent_width` DIP wide, its ink to be centred on `centre_x`, both in the
+// layout's coordinates. A `mirrored` parent (right to left) draws a child at
+// the mirror of its bounds while the text inside draws as it does left to
+// right, so the ink is centred where it is drawn, and the shift given back
+// is for the layout's bounds: the other way.
+int LayoutInkCentringShift(std::u16string_view text,
+                           const gfx::FontList& font_list,
+                           const gfx::Rect& label_bounds,
+                           float centre_x,
+                           int parent_width,
+                           bool mirrored);
+
 // `text` in `font_list` and `color` as an image `width` DIP wide, its ink
 // centred across it, and as tall as `width` or the text's line, whichever is
 // taller: a glyph that stands on an icon column as the icons' images do.
diff --git a/chrome/browser/ui/views/stedding/glyph_ink_unittest.cc b/chrome/browser/ui/views/stedding/glyph_ink_unittest.cc
index 01ad397d23e4f..374c5de1547da 100644
--- a/chrome/browser/ui/views/stedding/glyph_ink_unittest.cc
+++ b/chrome/browser/ui/views/stedding/glyph_ink_unittest.cc
@@ -101,6 +101,52 @@ TEST(GlyphInkTest, AGlyphMovedByItsShiftStandsOnTheCentre) {
   }
 }
 
+// sidebar Y8, spaces B11 right to left: a parent that mirrors its children
+// draws a label at the mirror of its bounds, and the text in it as it draws
+// left to right. A label a layout moves by LayoutInkCentringShift stands on
+// the centre asked for where it is drawn, whether the label sits in the
+// parent's middle or at its leading edge and the centre is the middle or
+// off it. The chips and the rail's title row moved the label by the shift
+// measured where it is drawn, which right to left is the other way.
+TEST(GlyphInkTest, AMirroredLabelStandsOnTheCentreWhereItIsDrawn) {
+  const gfx::FontList base;
+  const gfx::FontList font = base.DeriveWithSizeDelta(16 - base.GetFontSize());
+  constexpr int kParentWidth = 64;
+  for (const char* const utf8 : kGlyphs) {
+    const std::u16string glyph = base::UTF8ToUTF16(utf8);
+    const int width = gfx::GetStringWidth(glyph, font) + 1;
+    for (int x : {(kParentWidth - width) / 2, 6}) {
+      for (float centre : {32.f, 22.5f}) {
+        SCOPED_TRACE(testing::Message() << "glyph " << utf8 << ", label at "
+                                        << x << ", centre " << centre);
+        gfx::Rect label(x, 0, width, font.GetHeight());
+        EXPECT_EQ(InkCentringShift(glyph, font, label, centre),
+                  LayoutInkCentringShift(glyph, font, label, centre,
+                                         kParentWidth, /*mirrored=*/false))
+            << "left to right, the shift is the plain one";
+        label.Offset(LayoutInkCentringShift(glyph, font, label, centre,
+                                            kParentWidth, /*mirrored=*/true),
+                     0);
+        gfx::Rect drawn = label;
+        drawn.set_x(kParentWidth - label.right());
+        gfx::Canvas canvas(gfx::Size(kParentWidth, font.GetHeight()), kScale,
+                           /*is_opaque=*/false);
+        canvas.DrawStringRectWithFlags(
+            glyph, font, SK_ColorBLACK, drawn,
+            gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_ELLIPSIS |
+                gfx::Canvas::NO_SUBPIXEL_RENDERING);
+        const std::optional<double> ink = DrawnCentre(canvas.GetBitmap());
+        if (!ink) {
+          continue;
+        }
+        EXPECT_NEAR(kParentWidth - centre, *ink, 0.5)
+            << "the glyph stands " << *ink - (kParentWidth - centre)
+            << " DIP off where it is drawn";
+      }
+    }
+  }
+}
