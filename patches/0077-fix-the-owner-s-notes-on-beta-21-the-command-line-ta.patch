+  ASSERT_TRUE(browser()->tab_strip_model()->GetActiveTab()->IsSplit());
+  PageThemeColorController* const controller =
+      PageThemeColorController::From(browser());
+  ASSERT_TRUE(controller);
+  ASSERT_TRUE(controller->partner());
+  // On one of the bar's 16 levels a channel, so the bar is it exactly.
+  constexpr SkColor kNavy = SkColorSetRGB(0x11, 0x22, 0x33);
+  const auto reads_on = [](const ui::ColorProvider& provider, SkColor part) {
+    return color_utils::GetContrastRatio(
+        provider.GetColor(kColorToolbarButtonIcon), part);
+  };
+  {
+    SCOPED_TRACE("the other pane's page has no colour");
+    controller->SetColorForTesting(kNavy);
+    controller->SetPartnerColorForTesting(std::nullopt);
+    ui::ColorProviderKey::InitializerSupplier* const supplier =
+        controller->bar_supplier();
+    ASSERT_TRUE(supplier);
+    const std::unique_ptr<ui::ColorProvider> provider = OnTheSand(supplier);
+    // A grey of 2.8:1 on each; the navy's white has 2.1:1 on the sand.
+    EXPECT_GE(reads_on(*provider, kSand), 2.5);
+    EXPECT_GE(reads_on(*provider, kNavy), 2.5);
+    EXPECT_EQ(kNavy, provider->GetColor(kColorOmniboxResultsBackground))
