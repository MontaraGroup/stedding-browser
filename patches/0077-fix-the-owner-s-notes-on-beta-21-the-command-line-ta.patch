+  strip->SetTabPinned(strip->GetIndexOfTab(tabs[0]), true);
+  strip->SetTabPinned(strip->GetIndexOfTab(tabs[1]), true);
+  model->SetSpacePinned(tabs[2], true);
+  model->SetSpacePinned(tabs[3], true);
