+
+  constexpr struct {
+    int pref;
+    const char* name;
+  } kDensities[] = {{0, "Comfortable"}, {1, "Compact"}, {2, "Dense"}};
+  std::vector<Measured> open_rows;
+  std::vector<Measured> rail_rows;
+  for (const auto& each : kDensities) {
+    SCOPED_TRACE(each.name);
+    local_state->SetInteger(stedding::prefs::kSidebarDensity, each.pref);
+    ASSERT_NO_FATAL_FAILURE(settle());
+    const int height = stedding::SidebarRowHeight();
+    const int card_height = stedding::SidebarPinnedHeight();
+    const int preset_favicon = stedding::SidebarFaviconSize();
+    const Measured open = measure();
+    ASSERT_NO_FATAL_FAILURE(collapse(true));
+    const Measured rail = measure();
+    open_rows.push_back(open);
+    rail_rows.push_back(rail);
+
+    {
+      SCOPED_TRACE(base::StrCat({"open ", open.ToString()}));
+      EXPECT_EQ(height, open.pin.height());
+      EXPECT_EQ(height, open.plain.height());
+      EXPECT_EQ(height, open.header.height());
+      EXPECT_EQ(height, open.inner.height());
+      EXPECT_EQ(card_height, open.card.height());
+    }
+    {
+      SCOPED_TRACE(base::StrCat({"rail ", rail.ToString()}));
+      EXPECT_EQ(card_height, rail.card.height()) << "an essential's card";
+      EXPECT_EQ(height, rail.pin.height()) << "a Space pin";
+      EXPECT_EQ(height, rail.plain.height()) << "a plain row";
+      EXPECT_EQ(height, rail.header.height()) << "a folder's header";
+      EXPECT_EQ(height, rail.inner.height()) << "a folder's row";
+      EXPECT_EQ(gfx::Size(preset_favicon + 4, preset_favicon + 4),
+                rail.favicon);
+      // The rows' squares: as wide as they are tall, on the column, and an
+      // essential's card as wide.
+      EXPECT_EQ(height, stedding::RailRowSide());
+      EXPECT_EQ(height, rail.plain.width()) << "a rail row is a square";
+      EXPECT_EQ(height, rail.pin.width());
+      EXPECT_EQ(height, rail.inner.width());
+      EXPECT_EQ(height, rail.header.width());
+      EXPECT_EQ(height, rail.card.width()) << "the card is not the rows' width";
+      // The gaps, by the density: 6, 5, 4 between rows, 4, 3, 2 between
+      // cards.
+      const int gap = stedding::RailRowGap();
+      EXPECT_EQ(gap, rail.plain2.y() - rail.plain.bottom());
+      EXPECT_EQ(gap, rail.pin2.y() - rail.pin.bottom());
+      EXPECT_EQ(gap, rail.inner2.y() - rail.inner.bottom());
+      EXPECT_EQ(gap, rail.inner.y() - rail.header.bottom());
+      EXPECT_EQ(stedding::RailCardGap(), rail.card2.y() - rail.card.bottom());
+      EXPECT_NEAR(rail.plain.CenterPoint().x(), rail.pin.CenterPoint().x(), 1);
+      EXPECT_NEAR(rail.plain.CenterPoint().x(), rail.inner.CenterPoint().x(),
+                  1);
+      EXPECT_NEAR(rail.plain.CenterPoint().x(), rail.card.CenterPoint().x(), 1)
+          << "the cards stand on the rows' column";
+    }
+    ASSERT_NO_FATAL_FAILURE(collapse(false));
+  }
+
+  {
+    SCOPED_TRACE("the rail's gaps shrink with the rows");
+    for (size_t i = 1; i < rail_rows.size(); ++i) {
+      const Measured& looser = rail_rows[i - 1];
+      const Measured& denser = rail_rows[i];
+      SCOPED_TRACE(testing::Message() << "the density set to " << i);
+      EXPECT_LT(denser.plain2.y() - denser.plain.bottom(),
+                looser.plain2.y() - looser.plain.bottom())
+          << "between two rows";
+      EXPECT_LT(denser.pin2.y() - denser.pin.bottom(),
+                looser.pin2.y() - looser.pin.bottom())
+          << "between two Space pins";
+      EXPECT_LT(denser.inner2.y() - denser.inner.bottom(),
+                looser.inner2.y() - looser.inner.bottom())
+          << "between a folder's rows";
+      EXPECT_LT(denser.card2.y() - denser.card.bottom(),
+                looser.card2.y() - looser.card.bottom())
+          << "between two essentials";
+      EXPECT_LT(denser.plain.y() - denser.pin2.bottom(),
+                looser.plain.y() - looser.pin2.bottom())
+          << "from the pins over the Clear line to the rows under it";
+    }
+  }
+
+  {
+    // Settings, or the command bar, while the sidebar is the rail.
+    SCOPED_TRACE("a density changed in the rail");
+    ASSERT_NO_FATAL_FAILURE(collapse(true));
+    local_state->SetInteger(stedding::prefs::kSidebarDensity, 1);
+    ASSERT_NO_FATAL_FAILURE(settle());
+    const Measured rail = measure();
+    EXPECT_EQ(rail_rows[1].plain.size(), rail.plain.size());
+    EXPECT_EQ(rail_rows[1].plain2.y() - rail_rows[1].plain.y(),
+              rail.plain2.y() - rail.plain.y());
+    EXPECT_EQ(rail_rows[1].card.size(), rail.card.size());
+    ASSERT_NO_FATAL_FAILURE(collapse(false));
+  }
+  local_state->SetInteger(stedding::prefs::kSidebarDensity, 0);
+}
