+  // What is drawn now, from the top down.
+  struct Measured {
+    gfx::Rect card, card2, pin, pin2, clear, plain, plain2, header, inner,
+        inner2;
+    gfx::Size favicon;
+    std::string ToString() const {
+      return base::StrCat(
