+
+void RootTabCollectionNode::OnSplitTabChanged(const SplitTabChange& change) {
+  // Stedding (splits J11): a pane's accessible name says which side of the
+  // split it is on ("Page B - Left view"). The panes trading sides -- a split
+  // reversed, a row dropped on the page's left half -- moves a row within its
+  // split, which tells the row nothing, so the names kept the old sides.
+  // Chromium's horizontal strip names its tabs again here
+  // (TabStrip::OnSplitContentsChanged).
+  std::vector<std::pair<tabs::TabInterface*, int>> panes;
+  if (change.type == SplitTabChange::Type::kAdded) {
+    panes = change.GetAddedChange()->tabs();
+  } else if (change.type == SplitTabChange::Type::kContentsChanged) {
+    panes = change.GetContentsChange()->new_tabs();
+  }
+  for (const auto& [tab, index] : panes) {
+    if (TabView* const row = RowOf(tab)) {
+      row->UpdateAccessibleName();
+    }
+  }
+}
+
+void RootTabCollectionNode::OnTabChangedAt(tabs::TabInterface* tab,
+                                           TabChangeType change_type) {
+  // Stedding (tabs R4, R46): the model's word that a tab changed reaches its
+  // row, as it reaches Chromium's horizontal strip
+  // (BrowserTabStripController::TabChangedAt). A row reads its tab through
+  // the tab's UI helper, which tells it nothing of a tab marked asleep
+  // without a discard -- a restored tab the launch leaves unloaded -- so that
+  // row was drawn awake until its title or favicon next changed: never, for
+  // a page without a favicon (Windows, beta 21).
+  if (change_type != TabChangeType::kAll) {
+    return;
+  }
+  if (TabView* const row = RowOf(tab)) {
+    row->ReadTabDataAgain();
+  }
+}
