+// The sidebar's collapse to the rail and its expand (upstream's motions,
+// sidebar Y8, motion O2), with every step's width.
+IN_PROC_BROWSER_TEST_F(MotionFramesTest, SidebarCollapseAndExpand) {
+  if (!Animates()) {
+    GTEST_SKIP() << "the machine asks for reduced motion";
+  }
+  ASSERT_NO_FATAL_FAILURE(OpenTitledTabs(12));
+  ASSERT_NO_FATAL_FAILURE(AddASecondSpace());
+  // The eased width of each step, as a share of the way, in hundredths.
+  std::vector<int> values;
+  base::CallbackListSubscription subscription =
+      BrowserAnimationController::From(browser())->Subscribe(
+          TabStripAnimations::kVerticalTabStrip,
+          base::BindLambdaForTesting([&](const BrowserAnimationController* c,
+                                         BrowserAnimationUpdate update) {
+            if (update == BrowserAnimationUpdate::kProgressed) {
+              values.push_back(static_cast<int>(
+                  100 *
+                  c->GetCurrentValue(TabStripAnimations::kVerticalTabStrip,
+                                     TabStripAnimations::kTabStripWidth)
+                      .value_or(0)));
+            }
+          }));
+  for (const bool collapse : {true, false}) {
+    SCOPED_TRACE(collapse ? "collapse" : "expand");
+    // The window's own child windows, to name the ones the motion moves.
+    std::map<views::Widget*, gfx::Rect> windows;
+    for (views::Widget* const child :
+         views::Widget::GetAllChildWidgets(widget()->GetNativeView())) {
+      if (child != widget()) {
+        windows[child] = child->GetWindowBoundsInScreen();
+      }
+    }
+    FrameMeter meter;
+    meter.Start(compositor());
+    values.clear();
+    vertical_tab_strip_state_controller()->RequestCollapse(collapse);
+    ASSERT_TRUE(RunUntilSettled(meter, base::BindLambdaForTesting([&]() {
+                                  return !StripAnimating();
+                                })));
+    meter.Stop();
+    std::string steps;
+    int largest = 0;
+    for (size_t i = 0; i < values.size(); ++i) {
+      base::StrAppend(&steps, {" ", base::NumberToString(values[i])});
+      if (i) {
+        largest = std::max(largest, std::abs(values[i] - values[i - 1]));
+      }
+    }
+    std::string moved;
+    for (const auto& [child, bounds] : windows) {
+      if (child->GetWindowBoundsInScreen() != bounds) {
+        base::StrAppend(&moved, {" ", child->GetName(),
+                                 child->IsVisible() ? "" : " (hidden)"});
+      }
+    }
+    Log(meter, base::StrCat({collapse ? "sidebar collapse" : "sidebar expand",
+                             " (", base::NumberToString(values.size()),
+                             " steps, largest ", base::NumberToString(largest),
+                             "%:", steps, "; windows moved:", moved, ")"}));
+    EXPECT_EQ(collapse, vertical_tab_strip_state_controller()->IsCollapsed());
+    ExpectNoHiddenFieldLaidOut(meter);
+  }
+}
