diff --git a/chrome/test/stedding/popup_over_full_screen_browsertest.mm b/chrome/test/stedding/popup_over_full_screen_browsertest.mm
new file mode 100644
index 0000000000000..16417ea8312e8
--- /dev/null
+++ b/chrome/test/stedding/popup_over_full_screen_browsertest.mm
@@ -0,0 +1,163 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// windows G8: a popup window opened while the window in front is in full
+// screen -- an extension's window from chrome.windows.create with type
+// "popup", as a password manager opens to answer a page's passkey request --
+// appears over the full-screen window, in its space, as an auxiliary window of
+// the full screen. (A page's window.open popup opens as a tab in full screen,
+// Chromium's rule, and as a window otherwise.) An ordinary window goes to a desktop
+// space, and macOS slid out of the full-screen space to show it (the owner,
+// 2026-10-20). Beside a window that is not in full screen a popup stays an
+// ordinary window, which may take full screen of its own.
+
+#import <Cocoa/Cocoa.h>
+
+#include <string>
+
+#include "base/test/run_until.h"
+#include "chrome/browser/extensions/chrome_test_extension_loader.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "extensions/common/extension.h"
+#include "extensions/test/test_extension_dir.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/test/scoped_fake_nswindow_fullscreen.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+class PopupOverFullScreenTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("/title1.html")));
+  }
+
+  static NSWindow* WindowOf(BrowserWindowInterface* browser) {
+    return BrowserView::GetBrowserViewForBrowser(browser)
+        ->GetWidget()
+        ->GetNativeWindow()
+        .GetNativeNSWindow();
+  }
+
+  [[nodiscard]] bool EnterFullScreen() {
+    chrome::ToggleFullscreenMode(browser());
+    return base::test::RunUntil(
+        [&] { return browser()->GetWindow()->IsFullscreen(); });
+  }
+
+  // The window other than the test's own, once there is one, or null after a
+  // wait with the reason recorded.
+  BrowserWindowInterface* NewWindow(const std::string& what) {
+    const int tabs = browser()->GetTabStripModel()->count();
+    BrowserWindowInterface* found = nullptr;
+    const bool appeared = base::test::RunUntil([&] {
+      for (BrowserWindowInterface* const window :
+           GetAllBrowserWindowInterfaces()) {
+        if (window != browser()) {
+          found = window;
+        }
+      }
+      return found || browser()->GetTabStripModel()->count() != tabs;
+    });
+    if (!found) {
+      ADD_FAILURE() << what
+                    << (appeared ? " opened as a tab in the window"
+                                 : " opened nowhere");
+    }
+    return found;
+  }
+
+  // Loads an extension whose service worker opens a popup window as it
+  // starts, and returns that window.
+  BrowserWindowInterface* OpenAnExtensionsPopup() {
+    dir_.WriteManifest(
+        R"({"manifest_version": 3, "name": "Passkeys", "version": "1",)"
+        R"( "background": {"service_worker": "bg.js"}})");
+    dir_.WriteFile(FILE_PATH_LITERAL("bg.js"),
+                   "chrome.windows.create({type: 'popup', url: 'popup.html',"
+                   " width: 360, height: 280});");
+    dir_.WriteFile(FILE_PATH_LITERAL("popup.html"),
+                   "<!doctype html><title>Passkey</title>");
+    extensions::ChromeTestExtensionLoader loader(browser()->GetProfile());
+    if (!loader.LoadExtension(dir_.UnpackedPath())) {
+      return nullptr;
+    }
+    return NewWindow("the extension's popup");
+  }
+
+  // The page opens a popup window, as a sign-in page does.
+  BrowserWindowInterface* OpenAPagesPopup() {
+    if (!content::ExecJs(
+            browser()->GetTabStripModel()->GetActiveWebContents(),
+            "window.open('/title2.html', '', 'popup,width=360,height=280')")) {
+      return nullptr;
+    }
+    return NewWindow("the page's popup");
+  }
+
+  extensions::TestExtensionDir dir_;
+};
+
+// windows G8: over a full-screen window an extension's popup, as a password
+// manager opens for a passkey, joins the full-screen space as an auxiliary
+// window and shows there.
+IN_PROC_BROWSER_TEST_F(PopupOverFullScreenTest,
+                       AnExtensionsPopupOpensOverAFullScreenWindow) {
+  ui::test::ScopedFakeNSWindowFullscreen fake_fullscreen;
+  ASSERT_TRUE(EnterFullScreen());
+  ASSERT_EQ(browser(), GetLastActiveBrowserWindowInterfaceWithAnyProfile())
+      << "the full-screen window is not the one in front";
+  NSWindow* const full_screen = WindowOf(browser());
+  BrowserWindowInterface* const popup = OpenAnExtensionsPopup();
+  ASSERT_TRUE(popup);
+  EXPECT_TRUE(popup->GetType() == BrowserWindowInterface::TYPE_POPUP ||
+              popup->GetType() == BrowserWindowInterface::TYPE_APP_POPUP)
+      << "a window of type " << popup->GetType();
+  NSWindow* const window = WindowOf(popup);
+  ASSERT_TRUE(base::test::RunUntil([&] { return window.visible; }))
+      << "the popup never showed";
+  const NSWindowCollectionBehavior behavior = window.collectionBehavior;
+  EXPECT_TRUE(behavior & NSWindowCollectionBehaviorFullScreenAuxiliary)
+      << "the popup is not an auxiliary window of the full screen: "
+      << behavior;
+  EXPECT_FALSE(behavior & NSWindowCollectionBehaviorFullScreenPrimary);
+  EXPECT_TRUE(window.onActiveSpace);
+  EXPECT_TRUE(full_screen.onActiveSpace)
+      << "the full-screen window left the space in front";
+  EXPECT_TRUE(browser()->GetWindow()->IsFullscreen());
+}
+
+// windows G8: beside a window not in full screen, a popup is an ordinary
+// window, as Chromium's is.
+IN_PROC_BROWSER_TEST_F(PopupOverFullScreenTest,
+                       APopupBesideAnOrdinaryWindowIsOrdinary) {
+  ASSERT_FALSE(browser()->GetWindow()->IsFullscreen());
+  for (const bool from_an_extension : {true, false}) {
+    SCOPED_TRACE(from_an_extension ? "an extension's popup" : "a page's popup");
+    BrowserWindowInterface* const popup =
+        from_an_extension ? OpenAnExtensionsPopup() : OpenAPagesPopup();
+    ASSERT_TRUE(popup);
+    EXPECT_FALSE(WindowOf(popup).collectionBehavior &
+                 NSWindowCollectionBehaviorFullScreenAuxiliary);
+    popup->GetWindow()->Close();
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return GetAllBrowserWindowInterfaces().size() == 1u;
+    }));
+  }
+}
+
+}  // namespace
