+                                      bar()->children().end());
+    while (!pending.empty()) {
+      views::View* const view = pending.back();
+      pending.pop_back();
+      if (!view->GetVisible() || view->bounds().IsEmpty() ||
+          view == bar()->omnibox_view()) {
+        continue;
+      }
+      if (!views::IsViewClass<views::Button>(view)) {
+        pending.insert(pending.end(), view->children().begin(),
+                       view->children().end());
+        continue;
+      }
