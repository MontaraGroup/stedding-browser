+  model->SetActionVisibility(vault->id(), true);
+  ASSERT_TRUE(
+      chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return settled() && shows(); }))
+      << "pinned with the row hidden, the button is not in the row shown "
+         "again: "
+      << button->bounds().ToString();
+}
+
+// toolbar T43: pinned as the owner pinned a new extension -- with the pin in
+// the extensions menu, the menu open, on a page extensions cannot touch (the
+// store's own, here a chrome:// page) -- the button shows in the row at once,
+// in its own icon, which loads after the button is made; and stays when the
+// menu closes and the page changes.
+IN_PROC_BROWSER_TEST_F(HiddenRowControlsTest, APinFromTheMenuShowsAtOnce) {
+  const auto rich_animations =
+      gfx::AnimationTestApi::SetRichAnimationRenderMode(
+          gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("chrome://version")));
+  const scoped_refptr<const extensions::Extension> vault =
+      LoadAction("Stedding Vault Probe", /*popup=*/true, /*red_icon=*/true);
+  ASSERT_TRUE(vault);
+  ToolbarView* const row = browser_view()->toolbar();
+  ExtensionsToolbarDesktop* const container = row->extensions_container();
+  ASSERT_TRUE(container);
+  ToolbarActionView* const button = container->GetViewForId(vault->id());
+  ASSERT_TRUE(button);
+  views::AnimatingLayoutManager* const slide =
+      container->GetAnimatingLayoutManager();
+  const auto shows = [&]() {
+    views::test::RunScheduledLayout(widget());
+    if (slide->is_animating() || !button->IsDrawn() ||
+        button->size().IsEmpty()) {
+      return false;
+    }
+    return row->GetLocalBounds().Contains(views::View::ConvertRectToTarget(
+        button->parent(), row, button->bounds()));
+  };
+  // The button's picture shows the extension's own icon: red in its middle.
+  const auto red = [&]() {
+    const gfx::ImageSkia image = button->GetImage(views::Button::STATE_NORMAL);
+    if (image.isNull()) {
+      return false;
+    }
+    const SkBitmap bitmap = *image.bitmap();
+    const SkColor middle =
+        bitmap.getColor(bitmap.width() / 2, bitmap.height() / 2);
+    return SkColorGetR(middle) > 200 && SkColorGetG(middle) < 60 &&
+           SkColorGetB(middle) < 60;
+  };
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !slide->is_animating(); }));
+  ASSERT_FALSE(shows());
+
+  container->ToggleExtensionsMenu();
