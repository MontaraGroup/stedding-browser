+void TabStripCollection::MoveTopLevelFolder(FolderTabCollection* folder,
+                                            size_t to) {
+  CHECK(folder);
+  TabCollection* const top = unpinned_collection_;
+  CHECK_EQ(folder->GetParentCollection(), top);
+  const std::optional<size_t> from = top->GetIndexOfCollection(folder);
+  CHECK(from.has_value());
+  CHECK(to < top->ChildCount());
+  if (*from == to) {
+    return;
+  }
+  // As MoveFolderChild: the Impl function takes one off the index when the
+  // folder leaves a slot before its destination.
+  TabCollection::Position position{top->GetHandle(),
+                                  *from < to ? to + 1 : to};
+  MoveCollectionImpl(folder, position);
+}
