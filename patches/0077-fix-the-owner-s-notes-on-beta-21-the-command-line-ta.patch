+
+  // A left press and release at `screen_point` whose click count is
+  // `clicks`, handed to the window's root view as the window hands it a real
+  // one, so the views' own rule applies: a press keeps a double click's count
+  // only on the view that took the click before it. The platform's own count
+  // (time, place) is not what is tested here.
+  void ClickWithCountAt(const gfx::Point& screen_point, int clicks) {
+    views::View* const root = browser_view()->GetWidget()->GetRootView();
+    gfx::Point in_root = screen_point;
+    views::View::ConvertPointFromScreen(root, &in_root);
+    ui::MouseEvent press(ui::EventType::kMousePressed, in_root, in_root,
+                         ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON,
+                         ui::EF_LEFT_MOUSE_BUTTON);
+    press.SetClickCount(clicks);
+    ui::MouseEvent release(ui::EventType::kMouseReleased, in_root, in_root,
+                           ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON,
+                           ui::EF_LEFT_MOUSE_BUTTON);
+    release.SetClickCount(clicks);
+    root->OnMousePressed(press);
+    root->OnMouseReleased(release);
+  }
+
+  // Two clicks at `screen_point`, the second a double click's.
+  void DoubleClickAt(const gfx::Point& screen_point) {
+    ClickWithCountAt(screen_point, 1);
+    ClickWithCountAt(screen_point, 2);
+  }
