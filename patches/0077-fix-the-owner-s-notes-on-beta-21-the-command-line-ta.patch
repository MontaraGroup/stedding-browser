+                                      gfx::ImageSkia::CreateFrom1xBitmap(
+                                          picture)));
+  actions->OverrideText(chip_id, u"AI Mode");
+  actions->Show(chip_id);
+  actions->ShowSuggestionChip(chip_id, {.should_animate = false});
+  actions->Show(icon_id);
+  page_actions::PageActionView* const chip =
+      container->GetPageActionView(chip_id);
+  page_actions::PageActionView* const icon =
+      container->GetPageActionView(icon_id);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(view());
+    return chip->GetVisible() && chip->IsChipVisible() && icon->GetVisible();
+  })) << "the page actions did not show";
+  views::test::RunScheduledLayout(view());
