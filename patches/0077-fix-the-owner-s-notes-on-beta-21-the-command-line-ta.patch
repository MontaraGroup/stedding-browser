+// motion O6: in the Stedding window the sidebar's collapse, expand and hover
+// overlay ease out, over upstream's durations.
+IN_PROC_BROWSER_TEST_F(MotionFramesTest, SidebarMotionsEaseOut) {
+  const BrowserAnimationController* const controller =
+      BrowserAnimationController::From(browser());
+  for (const BrowserAnimationMotion motion :
+       {TabStripAnimations::kCollapse, TabStripAnimations::kExpand,
+        TabStripAnimations::kExpandOnHover,
+        TabStripAnimations::kCollapseOnHover}) {
+    const auto spec = controller->GetMotionSpecificationForTesting(
+        TabStripAnimations::kVerticalTabStrip, motion);
+    ASSERT_TRUE(spec);
+    EXPECT_EQ(gfx::Tween::EASE_OUT, spec->global_tween);
+  }
+#if BUILDFLAG(IS_MAC)
+  // Upstream's own times on the Mac.
+  EXPECT_EQ(base::Milliseconds(350),
+            controller
+                ->GetMotionSpecificationForTesting(
+                    TabStripAnimations::kVerticalTabStrip,
+                    TabStripAnimations::kCollapse)
+                ->GetDuration());
+  EXPECT_EQ(base::Milliseconds(400),
+            controller
+                ->GetMotionSpecificationForTesting(
+                    TabStripAnimations::kVerticalTabStrip,
+                    TabStripAnimations::kExpand)
+                ->GetDuration());
+#endif
+}
