+// tabs R54 (the owner, 2026-10-20: "If I open the home page it has it, then
+// the admin panel that has no favicon tag -- it disappears"): a tab that goes
+// to a page of the same site (eTLD+1) with no icon of its own, whose
+// /favicon.ico fails, keeps the site's last favicon until the site gives
+// another, in the open sidebar's row and the rail's, which read it where the
+// tab strip, the essentials and the switcher do (TabUIHelper::GetFavicon).
+// A page of another site never shows it.
+// Pages on more than one host: every name is this machine.
+class SidebarFaviconTest : public SidebarRailTest {
+ protected:
+  void SetUpOnMainThread() override {
+    SidebarRailTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(SidebarFaviconTest,
+                       ASiteKeepsItsFaviconOnAPageWithNone) {
+  // Which hosts asked for /favicon.ico, so a check waits for the request
+  // that fails. The server calls this on its own thread.
+  base::Lock lock;
+  std::set<std::string> asked_for_favicon;
+  embedded_test_server()->RegisterRequestMonitor(base::BindLambdaForTesting(
+      [&](const net::test_server::HttpRequest& request) {
+        if (request.relative_url != "/favicon.ico") {
+          return;
+        }
+        const auto host = request.headers.find("Host");
+        if (host != request.headers.end()) {
+          base::AutoLock hold(lock);
+          asked_for_favicon.insert(
+              host->second.substr(0, host->second.find(':')));
+        }
+      }));
+  const auto asked = [&](std::string_view host) {
+    base::AutoLock hold(lock);
+    return asked_for_favicon.contains(std::string(host));
+  };
+  ASSERT_TRUE(embedded_test_server()->Start());
+  // The home page has an icon; the admin page, on a subdomain of the same
+  // site, has none and no /favicon.ico; nor has a page of another site.
+  const GURL home = embedded_test_server()->GetURL(
+      "example.com", "/favicon/page_with_favicon.html");
+  const GURL admin =
+      embedded_test_server()->GetURL("admin.example.com", "/title1.html");
+  const GURL elsewhere =
+      embedded_test_server()->GetURL("example.org", "/title1.html");
+  content::WebContents* const contents =
+      tab_strip_model()->GetActiveWebContents();
+  tabs::TabInterface* const tab = tab_strip_model()->GetActiveTab();
+  favicon::ContentFaviconDriver* const driver =
+      favicon::ContentFaviconDriver::FromWebContents(contents);
+  ASSERT_TRUE(driver);
+  TabUIHelper* const helper = TabUIHelper::From(tab);
+  ASSERT_TRUE(helper);
+  views::Widget* const widget = browser_view()->GetWidget();
+  // The middle pixel of what the row draws, or nothing for the default
+  // globe, which is drawn from a vector, not an image.
+  const auto middle = [](const ui::ImageModel& icon) -> std::optional<SkColor> {
+    if (!icon.IsImage() || icon.GetImage().IsEmpty()) {
+      return std::nullopt;
+    }
+    const SkBitmap bitmap = icon.GetImage().AsBitmap();
+    return bitmap.getColor(bitmap.width() / 2, bitmap.height() / 2);
+  };
+  const auto drawn = [&]() -> std::optional<SkColor> {
+    TabView* const row =
+        stedding::test::FindDrawnRow(widget->GetRootView(), tab);
+    return row ? middle(row->data().favicon) : std::nullopt;
+  };
+  // Until the page's favicon has been looked for: its own, or the host's
+  // /favicon.ico, whose request fails.
+  const auto load = [&](const GURL& url, bool has_icon) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return (has_icon ? driver->FaviconIsValid() : asked(url.host())) &&
+             !driver->HasPendingTasksForTest();
+    }));
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+  };
+
+  ASSERT_NO_FATAL_FAILURE(load(home, /*has_icon=*/true));
+  const std::optional<SkColor> site_icon = middle(helper->GetFavicon());
+  ASSERT_TRUE(site_icon) << "the home page's icon did not arrive";
+  ASSERT_TRUE(base::test::RunUntil([&]() { return drawn() == site_icon; }));
+
+  {
+    SCOPED_TRACE("a page of the same site with no icon");
+    ASSERT_NO_FATAL_FAILURE(load(admin, /*has_icon=*/false));
+    EXPECT_FALSE(driver->FaviconIsValid()) << "the page gave an icon";
+    EXPECT_EQ(site_icon, middle(helper->GetFavicon()))
+        << "the site's favicon went";
+    EXPECT_TRUE(base::test::RunUntil([&]() { return drawn() == site_icon; }))
+        << "the open sidebar's row lost the site's favicon";
+    controller()->RequestCollapse(true);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+    EXPECT_EQ(site_icon, drawn()) << "the rail's row lost it";
+    controller()->RequestCollapse(false);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+  }
+
+  {
+    SCOPED_TRACE("a page of another site with no icon");
+    ASSERT_NO_FATAL_FAILURE(load(elsewhere, /*has_icon=*/false));
+    EXPECT_FALSE(middle(helper->GetFavicon()))
+        << "another site's page took this site's favicon";
+    EXPECT_TRUE(base::test::RunUntil([&]() { return !drawn(); }));
+  }
+
+  {
+    // Not carried back either: the tab left the site in between.
+    SCOPED_TRACE("back to the site, on its page with no icon");
+    ASSERT_NO_FATAL_FAILURE(load(admin, /*has_icon=*/false));
+    EXPECT_FALSE(middle(helper->GetFavicon()));
+  }
+}
