+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return region->is_expanded_on_hover() &&
+             !BrowserAnimationController::From(browser())->IsAnimating(
+                 TabStripAnimations::kVerticalTabStrip);
+    })) << "the sidebar did not open on hover";
+    TabView* const under = row_at(pointer);
+    ASSERT_TRUE(under) << "no row under the pointer";
+    EXPECT_TRUE(
+        base::test::RunUntil([&]() { return shows_the_card_of(under); }))
+        << "no card on the row under the still pointer";
+  }
+  {
+    SCOPED_TRACE("the next row the pointer enters");
+    views::test::RunScheduledLayout(widget());
+    TabView* const next = RowOf(second);
+    ASSERT_TRUE(next);
+    move_to(next->GetBoundsInScreen().CenterPoint());
+    EXPECT_TRUE(base::test::RunUntil([&]() { return shows_the_card_of(next); }))
+        << "no card on the next row";
+  }
+  region->SetHoveredForTesting(false);
+  const ui::MouseEvent exit(ui::EventType::kMouseExited, gfx::Point(),
+                            gfx::Point(), ui::EventTimeForNow(), ui::EF_NONE,
+                            ui::EF_NONE);
+  region->OnMouseExited(exit);
+  Unhover();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !region->is_expanded_on_hover() &&
+           !BrowserAnimationController::From(browser())->IsAnimating(
+               TabStripAnimations::kVerticalTabStrip);
+  }));
+  region->SetHoveredForTesting(std::nullopt);
+}
