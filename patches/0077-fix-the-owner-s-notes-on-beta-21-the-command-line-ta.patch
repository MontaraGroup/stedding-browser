+bool SpaceModel::IsFolderSpacePinned(
+    const tabs::FolderTabCollection* folder) const {
+  if (!folder) {
+    return false;
+  }
+  const std::vector<tabs::TabInterface*> tabs = folder->GetTabsRecursive();
+  return !tabs.empty() &&
+         std::ranges::all_of(tabs, [this](const tabs::TabInterface* tab) {
+           return IsSpacePinned(tab);
+         });
+}
+
+bool SpaceModel::CanPinFolder(const tabs::FolderTabCollection* folder) const {
+  if (!tab_strip_model_ || !folder || folder->TabCountRecursive() == 0) {
+    return false;
+  }
+  const tabs::TabCollection* const parent = folder->GetParentCollection();
+  return parent && parent->type() == tabs::TabCollection::Type::UNPINNED;
+}
+
+void SpaceModel::SetFolderSpacePinned(tabs::FolderTabCollection* folder,
+                                      bool pinned) {
+  if (!CanPinFolder(folder)) {
+    return;
+  }
+  // Each tab takes the pin in place, home and session write included (H1,
+  // H2): the folder moves as one below, not tab by tab.
+  for (tabs::TabInterface* const tab : folder->GetTabsRecursive()) {
+    SetSpacePinnedOnOneTab(tab, pinned, /*move=*/false);
+  }
+  // The end of the run, the folder aside: the first top-level row that is no
+  // pin -- a loose tab, a split with a loose pane, a group, a folder with a
+  // loose tab -- is where a pinned folder goes before, and an unpinned one
+  // too, at the top of the rows under the line.
+  const tabs::TabCollection* const top = folder->GetParentCollection();
+  const auto is_pin_row = [this](const tabs::Child& child) {
+    if (const auto* tab = std::get_if<tabs::ScopedTab>(&child)) {
+      return IsSpacePinned(tab->get());
+    }
+    const tabs::TabCollection* const collection =
+        std::get<std::unique_ptr<tabs::TabCollection>>(child).get();
+    if (collection->type() != tabs::TabCollection::Type::SPLIT &&
+        collection->type() != tabs::TabCollection::Type::FOLDER) {
+      return false;
+    }
+    const std::vector<tabs::TabInterface*> tabs =
+        collection->GetTabsRecursive();
+    return !tabs.empty() &&
+           std::ranges::all_of(tabs, [this](const tabs::TabInterface* tab) {
+             return IsSpacePinned(tab);
+           });
+  };
+  size_t slot = 0;
+  for (const tabs::Child& child : top->GetChildren()) {
+    if (const auto* collection =
+            std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+        collection && collection->get() == folder) {
+      continue;
+    }
+    if (!is_pin_row(child)) {
+      break;
+    }
+    ++slot;
+  }
+  tab_strip_model_->MoveTopLevelFolder(folder, slot);
+  // The row moved; the line and the run are drawn again.
+  for (tabs::TabInterface* const tab : folder->GetTabsRecursive()) {
+    observers_.Notify(&Observer::OnTabSpaceChanged, tab);
+  }
+}
