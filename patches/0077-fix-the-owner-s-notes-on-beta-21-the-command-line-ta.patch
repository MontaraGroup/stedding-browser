+// extension and its button appeared only after a restart (2026-10-20).
+IN_PROC_BROWSER_TEST_F(HiddenRowControlsTest, APinnedExtensionShowsAtOnce) {
+  // The slide is part of what is checked; a remote desktop session turns rich
+  // animations off.
+  const auto rich_animations =
+      gfx::AnimationTestApi::SetRichAnimationRenderMode(
+          gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  const scoped_refptr<const extensions::Extension> vault =
+      LoadAction("Stedding Vault Probe", /*popup=*/true);
+  const scoped_refptr<const extensions::Extension> other =
+      LoadAction("Stedding Another Probe", /*popup=*/false);
+  ASSERT_TRUE(vault && other);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("site.test", "/title1.html")));
+  ToolbarView* const row = browser_view()->toolbar();
+  ExtensionsToolbarDesktop* const container = row->extensions_container();
+  ASSERT_TRUE(container);
+  ToolbarActionView* const button = container->GetViewForId(vault->id());
+  ASSERT_TRUE(button);
+  views::AnimatingLayoutManager* const slide =
+      container->GetAnimatingLayoutManager();
+  ToolbarActionsModel* const model =
+      ToolbarActionsModel::Get(browser()->GetProfile());
+  ASSERT_FALSE(model->IsActionPinned(vault->id()));
+
+  // Drawn in the row, with room in it.
+  const auto shows = [&]() {
+    views::test::RunScheduledLayout(widget());
+    if (!button->IsDrawn() || button->size().IsEmpty()) {
+      return false;
+    }
+    return row->GetLocalBounds().Contains(views::View::ConvertRectToTarget(
+        button->parent(), row, button->bounds()));
+  };
+  const auto settled = [&]() {
+    views::test::RunScheduledLayout(widget());
+    return !slide->is_animating();
+  };
+  ASSERT_TRUE(base::test::RunUntil(settled));
+  EXPECT_FALSE(shows()) << "an extension not pinned shows in the row";
+
+  {
+    SCOPED_TRACE("pinned: the button shows at once");
+    const base::TimeTicks pinned = base::TimeTicks::Now();
+    model->SetActionVisibility(vault->id(), true);
+    EXPECT_TRUE(base::test::RunUntil([&]() { return settled() && shows(); }))
+        << "the pinned extension's button never showed: "
+        << button->bounds().ToString() << ", drawn " << button->IsDrawn()
+        << ", the container " << container->bounds().ToString();
+    EXPECT_LT(base::TimeTicks::Now() - pinned, base::Seconds(2));
+  }
+  {
+    SCOPED_TRACE("unpinned: it goes at once");
+    model->SetActionVisibility(vault->id(), false);
+    EXPECT_TRUE(base::test::RunUntil([&]() { return settled() && !shows(); }))
+        << "the unpinned extension's button stayed";
+  }
+  {
+    SCOPED_TRACE("pinned, the row laid out part of the way through the slide");
+    gfx::AnimationContainerTestApi clock(
+        slide->GetAnimationContainerForTesting());
+    model->SetActionVisibility(vault->id(), true);
+    ASSERT_TRUE(slide->is_animating());
+    clock.IncrementTime(base::Milliseconds(60));
+    views::test::RunScheduledLayout(widget());
+    clock.IncrementTime(base::Milliseconds(60));
+    views::test::RunScheduledLayout(widget());
+    clock.IncrementTime(base::Seconds(1));
+    views::test::RunScheduledLayout(widget());
+    EXPECT_FALSE(slide->is_animating());
+    EXPECT_TRUE(shows()) << "the pinned extension's button never showed: "
+                         << button->bounds().ToString();
+  }
+
+  ASSERT_NO_FATAL_FAILURE(HideTheRow());
+  // Each extension's place in actions mode.
+  const auto order = [&]() {
+    stedding::CommandBarView* const bar = OpenActions();
+    std::vector<std::u16string> titles = Titles(bar);
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+    std::erase_if(titles, [](const std::u16string& title) {
+      return title != u"Stedding Vault Probe" &&
+             title != u"Stedding Another Probe";
+    });
+    return titles;
+  };
+  EXPECT_EQ((std::vector<std::u16string>{u"Stedding Vault Probe",
+                                         u"Stedding Another Probe"}),
+            order())
+      << "the pinned extension first";
+  model->SetActionVisibility(vault->id(), false);
+  EXPECT_EQ((std::vector<std::u16string>{u"Stedding Another Probe",
+                                         u"Stedding Vault Probe"}),
+            order())
