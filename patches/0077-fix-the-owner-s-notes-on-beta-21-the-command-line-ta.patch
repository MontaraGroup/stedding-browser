+  const auto collapse = [&](bool collapsed) {
+    controller()->RequestCollapse(collapsed);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    ASSERT_EQ(collapsed, controller()->IsCollapsed());
+    ASSERT_NO_FATAL_FAILURE(settle());
