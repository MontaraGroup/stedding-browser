+        << "the page's left half is not the drop zone up to the rail";
+    Release(to);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return dragged->IsSplit(); }))
+        << "the drop beside the rail made no split";
+    EXPECT_EQ((std::vector<tabs::TabInterface*>{dragged, shown}),
+              panes(shown));
+  }
+  tab_strip_model()->RemoveSplit(*shown->GetSplit());
+  ASSERT_TRUE(close_on_leaving());
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  {
+    SCOPED_TRACE("a drop inside the opened sidebar reorders");
+    ASSERT_TRUE(open_on_hover()) << "the sidebar did not open on hover";
+    ASSERT_LT(Index(dragged), Index(last));
+    const gfx::Point from = RowCentre(last);
+    const gfx::Point to = RowCentre(dragged);
+    PointerPressAndMove(from, to);
+    EXPECT_TRUE(region->is_expanded_on_hover())
+        << "the sidebar closed under a drag inside it";
+    Release(to);
+    EXPECT_LT(Index(last), Index(dragged)) << "the drop did not reorder";
+    EXPECT_FALSE(last->IsSplit());
+    EXPECT_FALSE(dragged->IsSplit());
+    EXPECT_EQ(1u, WindowCount());
+  }
+  ASSERT_TRUE(close_on_leaving());
+  region->SetHoveredForTesting(std::nullopt);
+}
