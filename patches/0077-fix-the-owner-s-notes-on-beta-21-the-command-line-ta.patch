+// The two-finger swipe across the sidebar (spaces B35): each scroll event
+// moves the list's layer; the lift switches and the new Space settles.
+IN_PROC_BROWSER_TEST_F(MotionFramesTest, SpaceSwipe) {
+  if (!Animates()) {
