+    views::test::RunScheduledLayout(widget);
+  };
+  const auto row = [&](tabs::TabInterface* tab) -> gfx::Rect {
+    TabView* const view =
+        stedding::test::FindDrawnRow(widget->GetRootView(), tab);
+    if (!view) {
+      ADD_FAILURE() << "a tab has no drawn row";
+      return gfx::Rect();
+    }
+    return view->GetBoundsInScreen();
+  };
+  const auto favicon = [&](tabs::TabInterface* tab) -> gfx::Size {
+    TabView* const view =
