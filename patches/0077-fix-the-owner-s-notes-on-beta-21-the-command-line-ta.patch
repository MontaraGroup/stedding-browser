+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/pin_unload_request.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/sequenced_task_runner.h"
+#include "content/public/browser/web_contents.h"
+
+namespace stedding {
+
+PinUnloadRequest::PinUnloadRequest(content::WebContents* contents,
+                                   Answered answered)
+    : content::WebContentsUserData<PinUnloadRequest>(*contents),
+      answered_(std::move(answered)) {}
+
+PinUnloadRequest::~PinUnloadRequest() = default;
+
+// static
+void PinUnloadRequest::Ask(content::WebContents* contents, Answered answered) {
+  if (!contents || IsAsking(contents)) {
+    return;
+  }
+  CreateForWebContents(contents, std::move(answered));
+  // A tab's close: the page's prompt, when it asks, is Chromium's own.
+  contents->DispatchBeforeUnload(/*auto_cancel=*/false);
+}
+
+// static
+bool PinUnloadRequest::IsAsking(content::WebContents* contents) {
+  return contents && FromWebContents(contents);
+}
+
+// static
+bool PinUnloadRequest::TakeAnswer(content::WebContents* contents,
+                                  bool proceed) {
+  PinUnloadRequest* const request =
+      contents ? FromWebContents(contents) : nullptr;
+  if (!request) {
+    return false;
+  }
+  Answered answered = std::move(request->answered_);
+  contents->RemoveUserData(UserDataKey());
+  // Not inside the renderer's reply: the rule may replace the contents.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(answered), proceed));
+  return true;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PinUnloadRequest);
+
+}  // namespace stedding
