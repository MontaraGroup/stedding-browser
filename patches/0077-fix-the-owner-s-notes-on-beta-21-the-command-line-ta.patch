+// folders F38, pins H14 (the owner, 2026-10-20: "a folder can be dragged
+// into the pinned tabs", as in Arc). A folder's header dragged through the
+// window over the Clear line takes the folder into the Space's pinned run:
+// its tabs become Space pins, it stays a folder with its tabs, and it sits at
+// the run's end, over the line. A new pin joins the run after it. Dragged
+// back under the line it leaves the run, its tabs unpinned, at the top of
+// the rows there. The header's menu does the same, Pin Folder and Unpin
+// Folder. The header could not be dragged at all, and a folder of pins was
+// drawn under the line with every row after it.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, AFolderDraggedOverTheLineJoinsTheRun) {
+  tabs::TabInterface* const pin = tabs().GetActiveTab();
+  model().SetSpacePinned(pin, true);
+  tabs::TabInterface* const loose = AddBlankTab();
+  // A row that stays under the line throughout, so the line is drawn.
+  tabs::TabInterface* const tail = AddBlankTab();
+  tabs::TabInterface* const first = AddBlankTab();
+  tabs::TabInterface* const second = AddBlankTab();
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(
+      {tabs().GetIndexOfTab(first), tabs().GetIndexOfTab(second)});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Reading");
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  ASSERT_TRUE(IsAboveTheLine(pin));
+  ASSERT_FALSE(IsAboveTheLine(first));
+  stedding::test::KeepAboveOtherWindows(widget());
+
+  const auto header_view = [&]() {
+    views::test::RunScheduledLayout(widget());
+    return stedding::test::FindDrawnFolder(widget()->GetRootView(), folder);
+  };
+  // Whether the folder's header is drawn above the Clear line.
+  const auto header_above_the_line = [&]() {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    FolderView* const view = header_view();
+    const ClearTabsSeparator* const line =
+        stedding::test::FindDrawnClearLine(widget()->GetRootView());
+    EXPECT_TRUE(view && line);
+    return view && line &&
+           view->GetHeaderBoundsInScreen().bottom() <=
+               line->GetBoundsInScreen().y();
+  };
+  // A press on the header, a drag in steps to `to`, a release there, as the
+  // window hands a person's.
+  const auto drag_header_to = [&](const gfx::Point& to) {
+    FolderView* const view = header_view();
+    ASSERT_TRUE(view);
+    const gfx::Point from = view->GetHeaderBoundsInScreen().CenterPoint();
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed,
+                                  from);
+    constexpr int kSteps = 12;
+    for (int i = 1; i <= kSteps; ++i) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * i / kSteps,
+                     from.y() + (to.y() - from.y()) * i / kSteps));
+    }
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, to);
+  };
+  const auto row_centre = [&](const tabs::TabInterface* tab) {
+    views::test::RunScheduledLayout(widget());
+    const TabView* const row =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+    return row ? row->GetBoundsInScreen().CenterPoint() : gfx::Point();
+  };
+  const auto in_the_folder = [&](const tabs::TabInterface* tab) {
+    return tab->GetParentCollection() == folder;
+  };
+
+  {
+    SCOPED_TRACE("the header dragged onto the pin, over the line");
+    ASSERT_NO_FATAL_FAILURE(drag_header_to(row_centre(pin)));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return model().IsSpacePinned(first) && model().IsSpacePinned(second);
+    })) << "the folder's tabs did not become pins";
+    EXPECT_TRUE(in_the_folder(first) && in_the_folder(second))
+        << "the folder lost its tabs";
+    EXPECT_FALSE(folder->collapsed()) << "the drag toggled the folder";
+    EXPECT_TRUE(header_above_the_line()) << "the folder is under the line";
+    EXPECT_TRUE(IsAboveTheLine(pin));
+    EXPECT_TRUE(IsAboveTheLine(first));
+    EXPECT_FALSE(IsAboveTheLine(loose));
+    EXPECT_FALSE(IsAboveTheLine(tail));
+    // The run's order: the pin, then the folder at its end.
+    EXPECT_LT(tabs().GetIndexOfTab(pin), tabs().GetIndexOfTab(first));
+    EXPECT_LT(tabs().GetIndexOfTab(second), tabs().GetIndexOfTab(loose));
+  }
+
+  {
+    SCOPED_TRACE("a new pin joins the run after the folder");
+    model().SetSpacePinned(loose, true);
+    EXPECT_TRUE(IsAboveTheLine(loose));
+    EXPECT_FALSE(in_the_folder(loose));
+    EXPECT_LT(tabs().GetIndexOfTab(second), tabs().GetIndexOfTab(loose));
+    model().SetSpacePinned(loose, false);
+    EXPECT_FALSE(IsAboveTheLine(loose));
+    EXPECT_TRUE(header_above_the_line());
+  }
+
+  {
+    // As a middle click or a Cmd-click on a link in the folder's first tab.
+    SCOPED_TRACE("a link opened from a tab of the pinned folder");
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(first));
+    NavigateParams params(browser(), GURL("about:blank#child"),
+                          ui::PAGE_TRANSITION_LINK);
+    params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    params.source_contents = first->GetContents();
+    Navigate(&params);
+    tabs::TabInterface* const opened =
+        tabs().GetTabForWebContents(params.navigated_or_inserted_contents);
+    ASSERT_TRUE(opened);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !in_the_folder(opened); }))
+        << "the new tab stayed in the pinned folder";
+    EXPECT_FALSE(model().IsSpacePinned(opened));
+    EXPECT_FALSE(IsAboveTheLine(opened));
+    EXPECT_TRUE(header_above_the_line()) << "the folder left the run";
+    EXPECT_EQ(tabs().GetIndexOfTab(second) + 1, tabs().GetIndexOfTab(opened))
+        << "not just after the run";
+    tabs().CloseWebContentsAt(tabs().GetIndexOfTab(opened),
+                              TabCloseTypes::CLOSE_NONE);
+  }
