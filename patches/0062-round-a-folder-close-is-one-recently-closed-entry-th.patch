+// PLAN.md CMD-1 (F61): an extension with an action and a side panel,
+// reloaded and then disabled while the bar is open, leaves the bar whole.
+// Chromium's action-registry rows bound an extension's item by pointer, and a
+// reload freed the item under an open bar; the bar lists Stedding's own rows,
+// so it never lists the extension, holds nothing of it, and lists and runs
+// rows after either change.
+IN_PROC_BROWSER_TEST_F(CommandBarActionsTest,
+                       AnExtensionReloadedUnderTheOpenBarLeavesItWhole) {
+  extensions::TestExtensionDir dir;
+  dir.WriteManifest(R"({
+    "manifest_version": 3,
+    "name": "Steady Panel",
+    "version": "1",
+    "action": {"default_title": "Steady Panel"},
+    "side_panel": {"default_path": "panel.html"},
+    "permissions": ["sidePanel"]
+  })");
+  dir.WriteFile(FILE_PATH_LITERAL("panel.html"), "<!doctype html><p>Panel");
+  Profile* const profile = browser()->GetProfile();
+  const scoped_refptr<const extensions::Extension> extension =
+      extensions::ChromeTestExtensionLoader(profile).LoadExtension(
+          dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  const extensions::ExtensionId id = extension->id();
+  extensions::ExtensionRegistry* const registry =
+      extensions::ExtensionRegistry::Get(profile);
+
+  stedding::CommandBarView* const bar = Palette(browser());
+  ASSERT_TRUE(bar);
+  const auto lists_no_extension = [&]() {
+    for (const char16_t* query : {u"Steady", u"Panel", u"Side", u""}) {
+      Type(bar, query);
+      for (const std::u16string& title : Titles(bar)) {
+        EXPECT_EQ(std::u16string::npos, title.find(u"Steady")) << title;
+      }
+    }
+  };
+  lists_no_extension();
+
+  {
+    extensions::TestExtensionRegistryObserver reloaded(registry, id);
+    extensions::ExtensionRegistrar::Get(profile)->ReloadExtension(id);
+    ASSERT_TRUE(reloaded.WaitForExtensionLoaded());
+  }
+  ASSERT_EQ(bar, stedding::CommandBarView::GetOpenBar(
+                     BrowserView::GetBrowserViewForBrowser(browser())))
+      << "the reload closed the bar";
+  lists_no_extension();
+
+  {
+    extensions::TestExtensionRegistryObserver unloaded(registry, id);
+    extensions::ExtensionRegistrar::Get(profile)->DisableExtension(
+        id, {extensions::disable_reason::DISABLE_USER_ACTION});
+    ASSERT_TRUE(unloaded.WaitForExtensionUnloaded());
+  }
+  lists_no_extension();
+
+  // A row run from the same bar: Duplicate Tab adds a tab.
+  const int tabs_before = browser()->GetTabStripModel()->count();
+  Type(bar, u"Duplicate Tab");
+  const std::vector<std::u16string> titles = Titles(bar);
+  const auto row = std::ranges::find(titles, u"Duplicate Tab");
+  ASSERT_NE(titles.end(), row) << "the bar lists no Duplicate Tab";
+  for (size_t i = 0; i < static_cast<size_t>(row - titles.begin()); ++i) {
+    Press(bar, ui::VKEY_DOWN);
+  }
+  Press(bar, ui::VKEY_RETURN);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return browser()->GetTabStripModel()->count() == tabs_before + 1;
+  })) << "the row did not run";
+}
