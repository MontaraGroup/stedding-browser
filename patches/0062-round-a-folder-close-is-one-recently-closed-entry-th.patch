@@ -0,0 +1,73 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_ARCHIVE_CLOSED_FOLDER_H_
+#define CHROME_BROWSER_UI_ARCHIVE_CLOSED_FOLDER_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/sessions/core/tab_restore_types.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace sessions {
+class LiveTab;
+class LiveTabContext;
+}  // namespace sessions
+
+namespace stedding {
+
+// PLAN.md TAB-13, docs/features/folders.md F19: a folder's tabs closed
+// together come back together. Close Folder's Tabs marks each tab it closes
+// with the close's batch (archive_mark.h). The recently-closed list keeps an
+// entry per tab, as for any close, so Undo, the Archived view and the saved
+// list read them as before; the menus that list recently closed tabs and ⇧⌘T
+// show a batch as one folder and bring it back whole.
+
+// The batch of the Close Folder's Tabs that recorded `entry`, or "" for an
+// entry any other close made.
+std::string ClosedFolderBatchOf(const sessions::tab_restore::Entry& entry);
+
+// One folder close as the recently-closed list holds it.
+struct ClosedFolder {
+  ClosedFolder();
+  ClosedFolder(const ClosedFolder&);
+  ClosedFolder& operator=(const ClosedFolder&);
+  ~ClosedFolder();
+
+  std::string batch;
+  // The folder's name when it was closed.
+  std::u16string name;
+  // Its tabs' entries, in the folder's order: the oldest entry first.
+  std::vector<raw_ptr<const sessions::tab_restore::Tab, VectorExperimental>>
+      tabs;
+};
+
+// The folder close that recorded the entry at `it`: every tab entry of that
+// close, wherever it is in `entries`. nullopt for an entry no folder close
+// made.
+std::optional<ClosedFolder> ClosedFolderAt(
+    const sessions::TabRestoreService::Entries& entries,
+    sessions::TabRestoreService::Entries::const_iterator it);
+
+// Restores every tab of the folder close `batch` and returns them, the folder
+// together and in its order. For UNKNOWN, as ⇧⌘T restores, each tab goes back
+// to its place, the folder's first tab shown; otherwise the first comes back
+// with `disposition` and the rest after it, in the background. With no
+// `context` the tabs go back to their window, which the first restore opens.
+// The tabs' folder path puts them back in their folder
+// (FolderSessionService).
+std::vector<sessions::LiveTab*> RestoreClosedFolder(
+    sessions::TabRestoreService& service,
+    sessions::LiveTabContext* context,
+    std::string_view batch,
+    WindowOpenDisposition disposition);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_ARCHIVE_CLOSED_FOLDER_H_
diff --git a/chrome/browser/ui/archive/closed_folder_unittest.cc b/chrome/browser/ui/archive/closed_folder_unittest.cc
new file mode 100644
index 0000000000000..edaee635480b4
--- /dev/null
+++ b/chrome/browser/ui/archive/closed_folder_unittest.cc
@@ -0,0 +1,91 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/archive/closed_folder.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "chrome/browser/ui/archive/archive_mark.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/sessions/core/tab_restore_types.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// A tab entry of the recently-closed list, on `url`, closed by the folder
+// close `batch` of the folder `name`, or by any other close for "".
+std::unique_ptr<sessions::tab_restore::Tab> Closed(const std::string& url,
+                                                   const std::string& batch,
+                                                   const std::string& name) {
+  auto tab = std::make_unique<sessions::tab_restore::Tab>();
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_virtual_url(GURL(url));
+  tab->navigations.push_back(navigation);
+  if (!batch.empty()) {
+    tab->extra_data[kClosedFolderKey] = batch;
+    tab->extra_data[kClosedFolderNameKey] = name;
+  }
+  return tab;
+}
+
+std::string Urls(const ClosedFolder& folder) {
+  std::string urls;
+  for (const auto& tab : folder.tabs) {
+    urls += std::string(tab->navigations.front().virtual_url().host()) + " ";
+  }
+  return urls;
+}
+
+// PLAN.md TAB-13: the list is newest first. A folder close of a, b, c (in
+// that order) sits under a later plain close; any of its entries finds the
+// whole close, in the folder's order, with the folder's name, and a plain
+// close is no folder's.
+TEST(ClosedFolderTest, AnyEntryOfAFolderCloseFindsItWhole) {
+  sessions::TabRestoreService::Entries entries;
+  entries.push_back(Closed("https://later.test/", "", ""));
+  entries.push_back(Closed("https://c.test/", "batch-1", "Reading"));
+  entries.push_back(Closed("https://b.test/", "batch-1", "Reading"));
+  entries.push_back(Closed("https://a.test/", "batch-1", "Reading"));
+  entries.push_back(Closed("https://earlier.test/", "", ""));
+
+  auto it = entries.begin();
+  EXPECT_EQ(std::nullopt, ClosedFolderAt(entries, it)) << "a plain close";
+  ++it;
+  const std::optional<ClosedFolder> folder = ClosedFolderAt(entries, it);
+  ASSERT_TRUE(folder);
+  EXPECT_EQ("batch-1", folder->batch);
+  EXPECT_EQ(u"Reading", folder->name);
+  EXPECT_EQ("a.test b.test c.test ", Urls(*folder));
+  ++it;
+  ++it;
+  const std::optional<ClosedFolder> from_last = ClosedFolderAt(entries, it);
+  ASSERT_TRUE(from_last);
+  EXPECT_EQ("a.test b.test c.test ", Urls(*from_last));
+  EXPECT_EQ(std::nullopt, ClosedFolderAt(entries, entries.end()));
+}
+
+// Two folder closes stay apart, even of folders with the same name.
+TEST(ClosedFolderTest, TwoClosesOfOneNameStayApart) {
+  sessions::TabRestoreService::Entries entries;
+  entries.push_back(Closed("https://d.test/", "batch-2", "Reading"));
+  entries.push_back(Closed("https://b.test/", "batch-1", "Reading"));
+  entries.push_back(Closed("https://a.test/", "batch-1", "Reading"));
+
+  const std::optional<ClosedFolder> newer =
+      ClosedFolderAt(entries, entries.begin());
+  ASSERT_TRUE(newer);
+  EXPECT_EQ("d.test ", Urls(*newer));
+  const std::optional<ClosedFolder> older =
+      ClosedFolderAt(entries, std::next(entries.begin()));
+  ASSERT_TRUE(older);
+  EXPECT_EQ("a.test b.test ", Urls(*older));
+}
+
