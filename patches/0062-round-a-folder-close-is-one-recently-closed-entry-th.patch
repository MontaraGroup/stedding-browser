+  ASSERT_TRUE(again && again->type() == tabs::TabCollection::Type::FOLDER);
+  tab_strip_model()->ActivateTabAt(0);
+  tab_strip_model()->CloseFolderTabs(const_cast<tabs::FolderTabCollection*>(
+      static_cast<const tabs::FolderTabCollection*>(again)));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return tab_strip_model()->count() == 1; }));
+  chrome::RestoreTab(browser());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return in_reading() == "a.test b.test c.test ";
+  })) << "⇧⌘T brought back \"" << in_reading() << "\"";
+}
