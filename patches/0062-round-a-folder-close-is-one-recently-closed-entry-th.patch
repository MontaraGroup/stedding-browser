diff --git a/chrome/test/stedding/quiet_start_browsertest.cc b/chrome/test/stedding/quiet_start_browsertest.cc
new file mode 100644
index 0000000000000..2328499579f92
--- /dev/null
+++ b/chrome/test/stedding/quiet_start_browsertest.cc
@@ -0,0 +1,154 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A fresh profile at rest calls on no Google service it has no use for
+// (docs/PRIVACY.md, principle 2; docs/features/privacy.md Q11, Q12). The
+// recorded run of 2026-09-28 caught two: Google's push service, checked in
+// with and registered to within a minute of the first start, and the Google
+// account check, which sent the profile's Google cookies to
+// accounts.google.com (BACKLOG S-54, S-67).
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/run_loop.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/test/run_until.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/gcm/gcm_profile_service_factory.h"
+#include "chrome/browser/gcm/instance_id/instance_id_profile_service_factory.h"
+#include "chrome/browser/policy/policy_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/signin/identity_manager_factory.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/gcm_driver/gcm_driver.h"
+#include "components/gcm_driver/gcm_profile_service.h"
+#include "components/gcm_driver/instance_id/instance_id_driver.h"
+#include "components/gcm_driver/instance_id/instance_id_profile_service.h"
+#include "components/invalidation/invalidation_listener.h"
+#include "components/policy/core/common/remote_commands/remote_commands_constants.h"
+#include "components/signin/public/identity_manager/accounts_in_cookie_jar_info.h"
+#include "components/signin/public/identity_manager/identity_manager.h"
+#include "content/public/test/browser_test.h"
+#include "google_apis/gaia/gaia_switches.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "net/test/embedded_test_server/http_request.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+// Long enough for what the two checks did before they were fixed: the
+// account check reached the server within a second of the call, and the
+// push service's registration was asked for while the profile started.
+constexpr base::TimeDelta kSettle = base::Seconds(3);
+
+void Settle() {
+  base::RunLoop wait;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, wait.QuitClosure(), kSettle);
+  wait.Run();
+}
+
+class QuietStartTest : public InProcessBrowserTest {
+ protected:
+  QuietStartTest() : gaia_(net::EmbeddedTestServer::TYPE_HTTPS) {
+    // The monitor runs on the server's own thread.
+    gaia_.RegisterRequestMonitor(base::BindRepeating(
+        [](std::atomic<int>* list_accounts,
+           const net::test_server::HttpRequest& request) {
+          if (request.relative_url.starts_with("/ListAccounts")) {
+            list_accounts->fetch_add(1);
+          }
+        },
+        &list_accounts_));
+  }
+
+  // Google's accounts host is this server, from before the browser starts,
+  // so a request made while the profile starts is seen too. Browser sign-in
+  // is not allowed, as in a Stedding build: the build carries no OAuth client,
+  // and the test suite pretends one exists (ChromeTestSuite), which the
+  // switch takes back.
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    ASSERT_TRUE(gaia_.InitializeAndListen());
+    command_line->AppendSwitchASCII(switches::kGaiaUrl,
+                                    gaia_.base_url().spec());
+    if (!signin_allowed_) {
+      command_line->AppendSwitchASCII("allow-browser-signin", "false");
+    }
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    gaia_.StartAcceptingConnections();
+  }
+
+  bool signin_allowed_ = false;
+  std::atomic<int> list_accounts_{0};
+  net::EmbeddedTestServer gaia_;
+};
+
+// The control: where browser sign-in is allowed, the same server does see the
+// account check, so a count of none above is a check that did not happen, not
+// one this server could not see.
+class QuietStartSigninAllowedTest : public QuietStartTest {
+ protected:
+  QuietStartSigninAllowedTest() { signin_allowed_ = true; }
+};
+
+// privacy Q11 (S-54): the policy invalidations asked Google's push service
+// for a token as the profile started, whether or not any policy could ever
+// arrive; the push service is started on demand now, for a site's push
+// subscription or an extension that uses it, and a fresh profile starts it
+// for neither.
+IN_PROC_BROWSER_TEST_F(QuietStartTest, GooglesPushServiceStaysOff) {
+  Settle();
+  Profile* const profile = browser()->GetProfile();
+  instance_id::InstanceIDDriver* const instance_ids =
+      instance_id::InstanceIDProfileServiceFactory::GetForProfile(profile)
+          ->driver();
+  for (const int64_t project : {policy::kPolicyInvalidationProjectNumber,
+                                policy::kRemoteCommandsInvalidationsProjectNumber}) {
+    const std::string app =
+        base::StrCat({invalidation::InvalidationListener::kFmAppId, "-",
+                      base::NumberToString(project)});
+    EXPECT_FALSE(instance_ids->ExistsInstanceID(app))
+        << app << " asked the push service for a token";
+  }
+  EXPECT_FALSE(
+      gcm::GCMProfileServiceFactory::GetForProfile(profile)->driver()->IsStarted())
+      << "the push service started with nothing to deliver";
+}
+
+// privacy Q12 (S-67): with browser sign-in not allowed, as in every Stedding
+// build, nothing asks Google which accounts the profile's cookies hold: not
+// the startup's own readers, and not a read of the cookie jar after it.
+IN_PROC_BROWSER_TEST_F(QuietStartTest, NoGoogleAccountCheckWithoutSignIn) {
+  signin::IdentityManager* const identity_manager =
+      IdentityManagerFactory::GetForProfile(browser()->GetProfile());
+  // What the session-length metric, the account investigator and the trusted
+  // vault client each call at startup.
+  EXPECT_FALSE(identity_manager->GetAccountsInCookieJar().AreAccountsFresh());
+  Settle();
+  EXPECT_EQ(0, list_accounts_.load())
+      << "the profile asked accounts.google.com which accounts its cookies "
+         "hold";
+}
+
+IN_PROC_BROWSER_TEST_F(QuietStartSigninAllowedTest,
+                       TheServerSeesTheAccountCheckWhereSignInIsAllowed) {
+  signin::IdentityManager* const identity_manager =
+      IdentityManagerFactory::GetForProfile(browser()->GetProfile());
+  identity_manager->GetAccountsInCookieJar();
+  EXPECT_TRUE(base::test::RunUntil([&]() { return list_accounts_.load() > 0; }))
+      << "the server saw no account check even with sign-in allowed";
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/settings_security_browsertest.cc b/chrome/test/stedding/settings_security_browsertest.cc
new file mode 100644
index 0000000000000..462e616442b20
--- /dev/null
+++ b/chrome/test/stedding/settings_security_browsertest.cc
@@ -0,0 +1,73 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Settings -> Privacy and security -> Security says that Safe Browsing does
+// not work in Stedding builds, above the modes it offers (docs/features/
+// privacy.md Q13, PLAN.md WEB-5). Its list update is refused without a Google
+// API key, which these builds do not carry, so no page is checked whichever
+// mode is chosen (docs/PRIVACY.md).
+
+#include <string>
+
+#include "base/test/run_until.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace {
+
+using SettingsSecurityTest = InProcessBrowserTest;
+
+// The text of the element with id $1, as the page draws it, through every
+// shadow root, with its white space folded; "" until it is drawn.
+constexpr char kDrawnText[] = R"(
+  (() => {
+    const find = root => {
+      const hit = root.getElementById ? root.getElementById($1) : null;
+      if (hit) {
+        return hit;
+      }
+      for (const element of root.querySelectorAll('*')) {
+        if (element.shadowRoot) {
+          const found = find(element.shadowRoot);
+          if (found) {
+            return found;
+          }
+        }
+      }
+      return null;
+    };
+    const element = find(document);
+    return element && element.offsetParent !== null
+        ? element.textContent.replace(/\s+/g, ' ').trim()
+        : '';
+  })()
+)";
+
+// privacy Q13: the note is on the page a user opens to choose a mode, shown,
+// and says that the lists need a key the build does not have.
+IN_PROC_BROWSER_TEST_F(SettingsSecurityTest, ThePageSaysSafeBrowsingDoesNotWork) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://settings/security")));
+  content::WebContents* const page =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  std::string note;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    note = content::EvalJs(page, content::JsReplace(
+                                     kDrawnText,
+                                     "steddingSafeBrowsingUnavailable"))
+               .ExtractString();
+    return !note.empty();
+  })) << "chrome://settings/security shows no word about Safe Browsing";
+  EXPECT_EQ(0u, note.find("Safe Browsing does not work in Stedding yet."))
+      << note;
+  EXPECT_NE(std::string::npos, note.find("Stedding builds do not carry"))
+      << note;
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/tab_drop_browsertest.cc b/chrome/test/stedding/tab_drop_browsertest.cc
index 1052a048cb2b3..f98c27763edca 100644
--- a/chrome/test/stedding/tab_drop_browsertest.cc
+++ b/chrome/test/stedding/tab_drop_browsertest.cc
@@ -386,4 +386,69 @@ IN_PROC_BROWSER_TEST_F(TabDropTest, TabsDroppedOnAChipMoveToThatSpace) {
   }
 }
 
+// PLAN.md SPC-4, spaces B12: while a dragged row is over a chip that would
+// take it, that chip is lit; it goes dark when the pointer leaves it and once
+// the row is dropped, and an essential, which no chip takes, lights none.
+IN_PROC_BROWSER_TEST_F(TabDropTest, TheChipUnderADraggedRowIsLit) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const spaces::SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+  tabs::TabInterface* const essential = Open("essential.test");
+  tab_strip_model()->SetTabPinned(Index(essential), true);
+  tabs::TabInterface* const plain = Open("plain.test");
+  Open("stay.test");
+  ASSERT_TRUE(ChipCentre(work));
+  spaces::SpaceSwitcherView* const switcher = FindDrawnSwitcher(root());
+  ASSERT_TRUE(switcher);
+
+  // Pressed on the row, moved over the chip in steps, not released.
+  const gfx::Point row = RowCentre(plain);
+  const gfx::Point chip = *ChipCentre(work);
+  const auto move = [&](const gfx::Point& from, const gfx::Point& to) {
+    for (int step = 1; step <= 12; ++step) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * step / 12,
+                     from.y() + (to.y() - from.y()) * step / 12));
+    }
+    base::RunLoop().RunUntilIdle();
+  };
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, row);
+  move(row, chip);
+  EXPECT_EQ(work, switcher->drop_target_for_testing())
+      << "the chip under the dragged row is not lit";
+  views::View* const lit = switcher->ChipForTesting(work);
+  ASSERT_TRUE(lit);
+  EXPECT_TRUE(lit->GetBackground()) << "the lit chip draws nothing behind it";
+
+  // Away from the chips, back over the list: dark again.
+  move(chip, row);
+  EXPECT_EQ(std::nullopt, switcher->drop_target_for_testing())
+      << "the chip stayed lit with the pointer off it";
+
+  // Back over the chip and dropped: the row moves, and the chip goes dark.
+  move(row, chip);
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, chip);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return m->SpaceForTab(plain) == work;
+  })) << "the row did not move to Work";
+  EXPECT_EQ(std::nullopt, switcher->drop_target_for_testing())
+      << "the chip stayed lit after the drop";
+
+  // An essential belongs to every Space: no chip lights for it.
+  ASSERT_TRUE(m->SetActiveSpace(m->spaces().front()->id()));
+  tab_strip_model()->ActivateTabAt(Index(essential));
+  const gfx::Point pinned = RowCentre(essential);
+  const gfx::Point chip_again = *ChipCentre(work);
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, pinned);
+  move(pinned, chip_again);
+  EXPECT_EQ(std::nullopt, switcher->drop_target_for_testing())
+      << "a chip lit for an essential it will not take";
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased,
+                                chip_again);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(essential->IsPinned());
+}
+
 }  // namespace
