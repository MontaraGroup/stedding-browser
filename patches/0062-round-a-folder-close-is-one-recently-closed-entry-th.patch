diff --git a/chrome/browser/ui/archive/closed_folder.cc b/chrome/browser/ui/archive/closed_folder.cc
new file mode 100644
index 0000000000000..7189061888bbb
--- /dev/null
+++ b/chrome/browser/ui/archive/closed_folder.cc
@@ -0,0 +1,110 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/archive/closed_folder.h"
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/archive/archive_mark.h"
+#include "components/sessions/core/live_tab_context.h"
+#include "components/sessions/core/session_id.h"
+
+namespace stedding {
+
+ClosedFolder::ClosedFolder() = default;
+ClosedFolder::ClosedFolder(const ClosedFolder&) = default;
+ClosedFolder& ClosedFolder::operator=(const ClosedFolder&) = default;
+ClosedFolder::~ClosedFolder() = default;
+
+std::string ClosedFolderBatchOf(const sessions::tab_restore::Entry& entry) {
+  if (entry.type != sessions::tab_restore::TAB) {
+    return std::string();
+  }
+  const auto& tab = static_cast<const sessions::tab_restore::Tab&>(entry);
+  const auto it = tab.extra_data.find(kClosedFolderKey);
+  return it == tab.extra_data.end() ? std::string() : it->second;
+}
+
+std::optional<ClosedFolder> ClosedFolderAt(
+    const sessions::TabRestoreService::Entries& entries,
+    sessions::TabRestoreService::Entries::const_iterator it) {
+  if (it == entries.end()) {
+    return std::nullopt;
+  }
+  std::string batch = ClosedFolderBatchOf(**it);
+  if (batch.empty()) {
+    return std::nullopt;
+  }
+  ClosedFolder folder;
+  // The list is newest first; a close records its tabs in the folder's
+  // order, so the folder reads the list backwards.
+  for (auto entry = entries.rbegin(); entry != entries.rend(); ++entry) {
+    if (ClosedFolderBatchOf(**entry) == batch) {
+      folder.tabs.push_back(
+          static_cast<const sessions::tab_restore::Tab*>(entry->get()));
+    }
+  }
+  if (!folder.tabs.empty()) {
+    const auto name = folder.tabs.front()->extra_data.find(kClosedFolderNameKey);
+    if (name != folder.tabs.front()->extra_data.end()) {
+      folder.name = base::UTF8ToUTF16(name->second);
+    }
+  }
+  folder.batch = std::move(batch);
+  return folder;
+}
+
+std::vector<sessions::LiveTab*> RestoreClosedFolder(
+    sessions::TabRestoreService& service,
+    sessions::LiveTabContext* context,
+    std::string_view batch,
+    WindowOpenDisposition disposition) {
+  // The close's entries, oldest first: the folder's order.
+  std::vector<SessionID> ids;
+  int first_index = -1;
+  const sessions::TabRestoreService::Entries& entries = service.entries();
+  for (auto entry = entries.rbegin(); entry != entries.rend(); ++entry) {
+    if (batch.empty() || ClosedFolderBatchOf(**entry) != batch) {
+      continue;
+    }
+    if (ids.empty()) {
+      first_index =
+          static_cast<const sessions::tab_restore::Tab&>(**entry).tabstrip_index;
+    }
+    ids.push_back((*entry)->id);
+  }
+  // With no window to restore into, each tab finds the window the first one
+  // opened through its own browser id, which only UNKNOWN reads.
+  if (!context) {
+    disposition = WindowOpenDisposition::UNKNOWN;
+  }
+  std::vector<sessions::LiveTab*> restored;
+  const auto restore = [&](SessionID id, WindowOpenDisposition how) {
+    for (sessions::LiveTab* const live :
+         service.RestoreEntryById(context, id, how)) {
+      if (live) {
+        restored.push_back(live);
+      }
+    }
+  };
+  // UNKNOWN puts each tab back at the index it was closed from, and a close
+  // records each index after the tabs before it went: newest first, the
+  // restores undo the closes in turn and every tab lands where it was, the
+  // first of the folder last, and shown. Where the window has fewer tabs than
+  // the folder's place now, each goes to its end, so oldest first.
+  if (disposition == WindowOpenDisposition::UNKNOWN && context &&
+      first_index >= 0 && first_index <= context->GetTabCount()) {
+    for (auto id = ids.rbegin(); id != ids.rend(); ++id) {
+      restore(*id, WindowOpenDisposition::UNKNOWN);
+    }
+    return restored;
+  }
+  for (size_t i = 0; i < ids.size(); ++i) {
+    restore(ids[i], i == 0 || disposition == WindowOpenDisposition::UNKNOWN
+                        ? disposition
+                        : WindowOpenDisposition::NEW_BACKGROUND_TAB);
+  }
+  return restored;
+}
+
+}  // namespace stedding
