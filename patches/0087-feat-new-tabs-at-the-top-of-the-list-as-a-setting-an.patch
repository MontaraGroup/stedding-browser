+std::optional<int> SpaceModel::NewTabIndexAtTop() const {
+  if (!tab_strip_model_ || !profile_ ||
+      !profile_->GetPrefs()->GetBoolean(stedding::prefs::kNewTabsAtTop)) {
+    return std::nullopt;
+  }
+  // The top of the list is its first row below the Space's pins: the first
+  // tab of the active Space that is neither an essential nor a Space pin. A
+  // folder's first tab counts as its folder's place, so the tab opens above
+  // the folder, not in it. With no such row the end is the list's top too.
+  for (int i = 0; i < tab_strip_model_->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(i);
+    if (!tab || tab->IsPinned() || IsSpacePinned(tab) ||
+        !IsTabInActiveSpace(tab)) {
+      continue;
+    }
+    return i;
+  }
+  return std::nullopt;
+}
