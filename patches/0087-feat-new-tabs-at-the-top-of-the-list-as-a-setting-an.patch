+// pins H27 (BACKLOG S-289, GitHub issue 16): as in Arc, a tab's row dragged
+// over the essentials turns into a card under the pointer, the grid making
+// room for it where it would land and the list closing up over the row;
+// released, it settles into that room as an essential. An essential's card
+// dragged over the list turns into a row, and the rows part for it where it
+// would land, in place of the bar between them; released, it lands there.
+// Dragged back, the copy ends and the row or card is drawn again.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, ADraggedTabTurnsIntoACardAndBack) {
+  tabs::TabInterface* const essential = tabs().GetActiveTab();
+  tabs::TabInterface* const loose = AddBlankTab();
+  tabs::TabInterface* const tail = AddBlankTab();
+  tabs::TabInterface* const last = AddBlankTab();
+  tabs().SetTabPinned(tabs().GetIndexOfTab(essential), true);
+  ASSERT_TRUE(essential->IsPinned());
+  stedding::test::KeepAboveOtherWindows(widget());
+
+  views::View* const root = widget()->GetRootView();
+  const auto drawn = [&](const tabs::TabInterface* tab) {
+    views::test::RunScheduledLayout(widget());
+    return stedding::test::FindDrawnRow(root, tab);
+  };
+  const auto ghost = [&]() {
+    return stedding::test::FindView<EssentialsDragGhost>(root);
+  };
+  // The copy's shape in screen coordinates, once it has finished turning.
+  const auto ghost_shape = [&]() {
+    EssentialsDragGhost* const copy = ghost();
+    EXPECT_TRUE(copy) << "no floating copy";
+    if (!copy) {
+      return gfx::Rect();
+    }
+    EXPECT_TRUE(base::test::RunUntil([&]() { return !copy->IsAnimating(); }));
+    gfx::Rect bounds = copy->shape_bounds();
+    views::View::ConvertRectToScreen(copy->parent(), &bounds);
+    return bounds;
+  };
+  const auto opacity = [](const views::View* view) {
+    return view->layer() ? view->layer()->opacity() : 1.0f;
+  };
+  // A press on `from` and a drag in steps to `to`, the window laying out
+  // between two; the button is held.
+  const auto press_and_drag = [&](const gfx::Point& from,
+                                  const gfx::Point& to) {
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, from);
+    constexpr int kSteps = 20;
+    for (int i = 1; i <= kSteps; ++i) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * i / kSteps,
+                     from.y() + (to.y() - from.y()) * i / kSteps));
+      EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    }
+  };
+  const auto drag_on = [&](const gfx::Point& from, const gfx::Point& to) {
+    constexpr int kSteps = 10;
+    for (int i = 1; i <= kSteps; ++i) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * i / kSteps,
+                     from.y() + (to.y() - from.y()) * i / kSteps));
+      EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    }
+  };
+  const auto release = [&](const gfx::Point& at) {
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, at);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_TRUE(base::test::RunUntil([&]() { return !ghost(); }))
+        << "the floating copy stayed";
+  };
+
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  {
+    SCOPED_TRACE("a row over the essentials");
+    const TabView* const card = drawn(essential);
+    const TabView* const row = drawn(loose);
+    ASSERT_TRUE(card && row);
+    const gfx::Rect card_before = card->GetBoundsInScreen();
+    const gfx::Rect row_before = row->GetBoundsInScreen();
+    // The essential's card's first quarter: the room goes before it.
+    const gfx::Point over(card_before.x() + card_before.width() / 4,
+                          card_before.CenterPoint().y());
+    press_and_drag(row_before.CenterPoint(), over);
+
+    const gfx::Rect shape = ghost_shape();
+    ASSERT_TRUE(ghost());
+    EXPECT_TRUE(ghost()->as_card());
+    EXPECT_EQ(1.0, ghost()->card_amount());
+    EXPECT_NEAR(over.x(), shape.CenterPoint().x(), 2)
+        << "not under the pointer";
+    EXPECT_NEAR(over.y(), shape.CenterPoint().y(), 2)
+        << "not under the pointer";
+    EXPECT_EQ(GetLayoutConstant(LayoutConstant::kVerticalTabPinnedHeight),
+              shape.height())
+        << "not a card's height";
+    const gfx::Rect card_now = drawn(essential)->GetBoundsInScreen();
+    EXPECT_LT(card_now.width(), card_before.width()) << "the grid made no room";
+    EXPECT_GT(card_now.x(), card_before.x()) << "the room is not before it";
+    EXPECT_EQ(card_now.width(), shape.width())
+        << "the copy is not the size of the place made for it";
+    EXPECT_EQ(0.0f, opacity(drawn(loose))) << "the row is still drawn";
+    EXPECT_NEAR(row_before.y(), drawn(tail)->GetBoundsInScreen().y(), 1)
+        << "the list did not close up over the row";
+
+    release(over);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return loose->IsPinned(); }))
+        << "the tab did not become an essential";
+    EXPECT_EQ(Index(loose) + 1, Index(essential)) << "not where the room was";
+    ASSERT_TRUE(drawn(loose));
+    EXPECT_EQ(1.0f, opacity(drawn(loose))) << "its card is not shown";
+    EXPECT_EQ(1.0f, opacity(drawn(tail)));
+  }
+  {
+    SCOPED_TRACE("an essential over the list");
+    const TabView* const card = drawn(loose);
+    const TabView* const above = drawn(tail);
+    const TabView* const below = drawn(last);
+    ASSERT_TRUE(card && above && below);
+    const gfx::Rect above_before = above->GetBoundsInScreen();
+    const gfx::Rect below_before = below->GetBoundsInScreen();
+    // Between the two rows: the room goes before the second.
+    const gfx::Point between(above_before.CenterPoint().x(),
+                             (above_before.bottom() + below_before.y()) / 2);
+    press_and_drag(card->GetBoundsInScreen().CenterPoint(), between);
+
+    const gfx::Rect shape = ghost_shape();
+    ASSERT_TRUE(ghost());
+    EXPECT_FALSE(ghost()->as_card());
+    EXPECT_EQ(0.0, ghost()->card_amount());
+    EXPECT_NEAR(between.y(), shape.CenterPoint().y(), 2)
+        << "not under the pointer";
+    EXPECT_EQ(above_before.x(), shape.x()) << "not in line with the rows";
+    EXPECT_EQ(above_before.width(), shape.width());
+    EXPECT_EQ(above_before.height(), shape.height()) << "not a row's height";
+    EXPECT_EQ(0.0f, opacity(drawn(loose))) << "the card is still drawn";
+    EXPECT_NEAR(above_before.y(), drawn(tail)->GetBoundsInScreen().y(), 1);
+    EXPECT_GE(drawn(last)->GetBoundsInScreen().y(),
+              below_before.y() + above_before.height())
+        << "the rows did not part for it";
+    UnpinnedTabContainerView* const list =
+        stedding::test::FindView<UnpinnedTabContainerView>(root);
+    ASSERT_TRUE(list);
+    EXPECT_FALSE(list->GetRowDropIndicatorBoundsInScreenForTesting())
+        << "the bar is still drawn";
+
+    release(between);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !loose->IsPinned(); }))
+        << "it stayed an essential";
+    EXPECT_EQ(Index(tail) + 1, Index(loose));
+    EXPECT_EQ(Index(loose) + 1, Index(last)) << "not where the rows parted";
+    ASSERT_TRUE(drawn(loose));
+    EXPECT_EQ(1.0f, opacity(drawn(loose))) << "its row is not shown";
+  }
+  {
+    SCOPED_TRACE("a row taken over the essentials and back");
+    const TabView* const card = drawn(essential);
+    const TabView* const row = drawn(tail);
+    ASSERT_TRUE(card && row);
+    const gfx::Point home = row->GetBoundsInScreen().CenterPoint();
+    const gfx::Point over = card->GetBoundsInScreen().CenterPoint();
+    press_and_drag(home, over);
+    ASSERT_TRUE(ghost());
+    drag_on(over, home);
+    EXPECT_TRUE(base::test::RunUntil([&]() { return !ghost(); }))
+        << "the copy stayed over the list";
+    ASSERT_TRUE(drawn(tail));
+    EXPECT_EQ(1.0f, opacity(drawn(tail))) << "the row is not drawn again";
+    PinnedTabContainerView* const grid =
+        stedding::test::FindView<PinnedTabContainerView>(root);
+    ASSERT_TRUE(grid);
+    EXPECT_FALSE(grid->essentials_drop_room_index()) << "the room stayed";
+    release(home);
+    EXPECT_FALSE(tail->IsPinned()) << "it became an essential";
+  }
+}
+
+// tabs R62, settings T30 (GitHub issue 22): with "Open new tabs at the top of
+// the list" on, a new tab opens under + New Tab -- below the Space's pins and
+// above its older tabs, and above a folder that heads the list rather than in
+// it; off, as shipped, it opens at the end of the list.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, NewTabsOpenAtTheTopWhenAsked) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_FALSE(prefs->GetBoolean(stedding::prefs::kNewTabsAtTop))
+      << "the setting is off as shipped";
+  tabs::TabInterface* const first = tabs().GetActiveTab();
+  tabs::TabInterface* const pin = AddBlankTab();
+  model().SetSpacePinned(pin, true);
+  ASSERT_TRUE(model().IsSpacePinned(pin));
+  tabs::TabInterface* const older = AddBlankTab();
+  {
+    SCOPED_TRACE("off: at the end");
+    tabs::TabInterface* const added = AddBlankTab();
+    EXPECT_EQ(tabs().count() - 1, Index(added));
+    EXPECT_EQ(added, tabs().GetActiveTab());
+  }
+  prefs->SetBoolean(stedding::prefs::kNewTabsAtTop, true);
+  {
+    SCOPED_TRACE("on: under the pins, above the older tabs");
+    const int top = Index(first) < Index(older) ? Index(first) : Index(older);
+    tabs::TabInterface* const added = AddBlankTab();
+    EXPECT_EQ(added, tabs().GetActiveTab());
+    EXPECT_GT(Index(added), Index(pin)) << "above the Space's pins";
+    EXPECT_EQ(top, Index(added)) << "not the list's first row";
+    EXPECT_FALSE(model().IsSpacePinned(added));
+    EXPECT_FALSE(added->IsPinned());
+  }
+  {
+    SCOPED_TRACE("on, a folder heading the list: above it, not in it");
+    // The list's rows below the pins, in order; the first two make a folder.
+    std::vector<int> loose;
+    for (int i = 0; i < tabs().count(); ++i) {
+      tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+      if (!tab->IsPinned() && !model().IsSpacePinned(tab)) {
+        loose.push_back(i);
+      }
+    }
+    ASSERT_GE(loose.size(), 2u);
+    tabs::FolderTabCollection* const folder =
+        tabs().AddToNewFolder({loose[0], loose[1]});
+    ASSERT_TRUE(folder);
+    const int folder_top = loose[0];
+    tabs::TabInterface* const added = AddBlankTab();
+    EXPECT_EQ(folder_top, Index(added)) << "not above the folder";
+    EXPECT_FALSE(added->GetParentCollection() &&
+                 added->GetParentCollection() == folder)
+        << "the new tab joined the folder";
+  }
+  prefs->SetBoolean(stedding::prefs::kNewTabsAtTop, false);
+  {
+    SCOPED_TRACE("off again: at the end");
+    tabs::TabInterface* const added = AddBlankTab();
+    EXPECT_EQ(tabs().count() - 1, Index(added));
+  }
+}
