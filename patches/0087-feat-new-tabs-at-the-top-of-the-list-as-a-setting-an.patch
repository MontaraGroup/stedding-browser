+    color_utils::HSL swatch;
+    color_utils::SkColorToHSL(choice.color, &swatch);
+    double hue = std::abs(arc.h - swatch.h);
+    hue = std::min(hue, 1.0 - hue);  // around the wheel, at most a half turn
+    const double distance = hue * 2.0 + 0.25 * std::abs(arc.s - swatch.s) +
+                            0.5 * std::abs(arc.l - swatch.l);
