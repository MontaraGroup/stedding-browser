diff --git a/chrome/browser/ui/spaces/space_colors.h b/chrome/browser/ui/spaces/space_colors.h
index e0afc51c8b8fc..d37e786a4a853 100644
--- a/chrome/browser/ui/spaces/space_colors.h
+++ b/chrome/browser/ui/spaces/space_colors.h
@@ -11,22 +11,55 @@
 
 namespace spaces {
 
-// The five colours a Space can take: the switcher's menu offers them, a new
-// Space cycles through them, and the welcome flow shows them as swatches
-// (docs/features/welcome.md W7). One table, so every surface agrees.
+// The twelve colours a Space can take: the switcher's menu offers them, a new
+// Space cycles through them in this order, and the welcome flow shows them as
+// swatches (docs/features/welcome.md W7, spaces B40). One table, so every
+// surface agrees. They are designers' colours, not ours: Radix Colors' solid
+// steps (MIT; step 10 of its light scale where step 9 is too pale on a light
+// sidebar) and Tailwind's slate-500 (MIT). Each reads as a chip and a dot on
+// the sidebar's dark and light grounds, and as its tint (B11); no amber, the
+// owner's choice (2026-10-23). The first five keep the hues of the five there
+// were (UpdatedSpaceColor), in their order.
 struct SpaceColorChoice {
   SkColor color;
   const char16_t* name;
 };
 
 inline constexpr auto kSpaceColors = std::to_array<SpaceColorChoice>({
-    {SkColorSetRGB(0x5B, 0x6B, 0x8C), u"Slate"},
-    {SkColorSetRGB(0x7A, 0x5B, 0x8C), u"Plum"},
-    {SkColorSetRGB(0x5B, 0x8C, 0x74), u"Moss"},
-    {SkColorSetRGB(0x8C, 0x6B, 0x5B), u"Clay"},
-    {SkColorSetRGB(0x8C, 0x5B, 0x63), u"Rose"},
+    {SkColorSetRGB(0x64, 0x74, 0x8B), u"Slate"},   // Tailwind slate-500
+    {SkColorSetRGB(0xAB, 0x4A, 0xBA), u"Plum"},    // Radix plum 9
+    {SkColorSetRGB(0x3E, 0x9B, 0x4F), u"Green"},   // Radix grass 10
+    {SkColorSetRGB(0x95, 0x74, 0x68), u"Clay"},    // Radix bronze 10
+    {SkColorSetRGB(0xDC, 0x3B, 0x5D), u"Rose"},    // Radix ruby 10
+    {SkColorSetRGB(0x05, 0x88, 0xF0), u"Blue"},    // Radix blue 10
+    {SkColorSetRGB(0x6E, 0x56, 0xCF), u"Violet"},  // Radix violet 9
+    {SkColorSetRGB(0x0D, 0x9B, 0x8A), u"Teal"},    // Radix teal 10
+    {SkColorSetRGB(0xDD, 0x44, 0x25), u"Coral"},   // Radix tomato 10
+    {SkColorSetRGB(0x3E, 0x63, 0xDD), u"Indigo"},  // Radix indigo 9
+    {SkColorSetRGB(0xCF, 0x38, 0x97), u"Pink"},    // Radix pink 10
+    {SkColorSetRGB(0x07, 0x97, 0xB9), u"Cyan"},    // Radix cyan 10
 });
 
+// spaces B40: a Space saved with one of the five colours there were before
+// 2026-10-23 takes its new neighbour of the same hue and name; any other
+// colour (Arc's, from an import) is kept as it is.
+constexpr SkColor UpdatedSpaceColor(SkColor color) {
+  switch (color) {
+    case SkColorSetRGB(0x5B, 0x6B, 0x8C):  // Slate
+      return kSpaceColors[0].color;
+    case SkColorSetRGB(0x7A, 0x5B, 0x8C):  // Plum
+      return kSpaceColors[1].color;
+    case SkColorSetRGB(0x5B, 0x8C, 0x74):  // Moss
+      return kSpaceColors[2].color;
+    case SkColorSetRGB(0x8C, 0x6B, 0x5B):  // Clay
+      return kSpaceColors[3].color;
+    case SkColorSetRGB(0x8C, 0x5B, 0x63):  // Rose
+      return kSpaceColors[4].color;
+    default:
+      return color;
+  }
+}
+
 }  // namespace spaces
 
 #endif  // CHROME_BROWSER_UI_SPACES_SPACE_COLORS_H_
