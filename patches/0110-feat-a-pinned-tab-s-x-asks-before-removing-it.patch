@@ -378,6 +379,52 @@ CloseAction CloseActionForRow(BrowserWindowInterface* browser,
   return CloseActionForTabs(browser, prefs, model->SplitPeers(tab));
 }
 
+RowClose RowCloseFor(BrowserWindowInterface* browser,
+                     tabs::TabInterface* tab) {
+  Profile* const profile = browser ? browser->GetProfile() : nullptr;
+  if (CloseActionForRow(browser, profile ? profile->GetPrefs() : nullptr,
+                        tab) == CloseAction::kClose) {
+    return RowClose::kClose;
+  }
+  // Only a window with Spaces sleeps a pin (CloseActionForTabs), so there is
+  // a model here.
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  const tabs::TabInterface* const active =
+      browser->GetTabStripModel()->GetActiveTab();
+  bool on_screen = false;
+  bool space_pinned = false;
+  for (tabs::TabInterface* peer : model->SplitPeers(tab)) {
+    on_screen = on_screen || peer == active;
+    space_pinned = space_pinned || model->IsSpacePinned(peer);
+  }
+  return on_screen || !space_pinned ? RowClose::kSleep
+                                    : RowClose::kAskToRemove;
+}
+
+void RemovePinnedRow(BrowserWindowInterface* browser,
+                     tabs::TabInterface* tab) {
+  spaces::SpaceModel* const model =
+      browser ? spaces::SpaceModel::From(browser) : nullptr;
+  if (!tab || !model) {
+    return;
+  }
+  TabStripModel* const strip = browser->GetTabStripModel();
+  std::vector<int> indices;
+  for (tabs::TabInterface* peer : model->SplitPeers(tab)) {
+    if (const int index = strip->GetIndexOfTab(peer);
+        index != TabStripModel::kNoTab) {
+      indices.push_back(index);
+    }
+  }
+  // Last first, so each index still names its tab.
+  std::ranges::sort(indices, std::ranges::greater());
+  for (int index : indices) {
+    strip->CloseWebContentsAt(index,
+                              TabCloseTypes::CLOSE_USER_GESTURE |
+                                  TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
+
 bool SleepInsteadOfClose(BrowserWindowInterface* browser) {
   TabStripModel* const tabs = browser ? browser->GetTabStripModel() : nullptr;
   return tabs && SleepOrLeaveToClose(browser, Selection(tabs));
