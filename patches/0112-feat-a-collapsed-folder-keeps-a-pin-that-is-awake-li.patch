+// folders F3 (GitHub issue 35): a collapsed folder keeps listing a pin of its
+// Space that is awake after another tab is on screen, so going back to it
+// does not take opening the folder; asleep, the pin folds away with the
+// rest, and a tab that is not a pin does too.
+TEST_F(SpaceWindowTest, ACollapsedFolderKeepsAnAwakePinListed) {
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const pinned = OpenTab();
+  model().SetSpacePinned(pinned, true);
+  tabs::TabInterface* const other = OpenTab();
+  model().SetSpaceForTab(other, work->id());
+  std::vector<int> indices = {tabs().GetIndexOfTab(pinned),
+                              tabs().GetIndexOfTab(other)};
+  std::ranges::sort(indices);
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(indices);
+  ASSERT_NE(nullptr, folder);
+  folder->SetCollapsed(true);
+  tabs::TabInterface* const elsewhere = OpenTab();
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(elsewhere));
+  ASSERT_NE(pinned, tabs().GetActiveTab());
+  ASSERT_FALSE(pinned->GetContents()->WasDiscarded());
+
+  EXPECT_FALSE(tabs().IsTabHidden(tabs().GetIndexOfTab(pinned)))
+      << "the collapsed folder hid a pin that is awake";
+  EXPECT_TRUE(tabs().IsTabHidden(tabs().GetIndexOfTab(other)))
+      << "the collapsed folder listed a tab that is not a pin";
+
+  pinned->GetContents()->SetWasDiscarded(true);
+  EXPECT_TRUE(tabs().IsTabHidden(tabs().GetIndexOfTab(pinned)))
+      << "the collapsed folder listed a pin that is asleep";
+}
