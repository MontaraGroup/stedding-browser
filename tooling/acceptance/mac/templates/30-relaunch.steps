# S-173 / TST-6, the core loop, run 3 of 3: steps 11 to 13 (tooling/drive <profile>
# 30-relaunch.steps, no pages). Stedding starts on the profile run 2 quit.
activate
wait 4
# Step 11: relaunched, everything as it was left.
shot @SHOTS@/tst6-11a-relaunched.png
key 2+ctrl
wait 2
shot @SHOTS@/tst6-11b-work.png
key 3+ctrl
wait 2
shot @SHOTS@/tst6-11c-play.png
key 1+ctrl
wait 2
shot @SHOTS@/tst6-11d-home.png
# Step 12: Cmd-T, an address, Enter.
key t+cmd
wait 1
type file://@PAGES@/g.html
wait 1
shot @SHOTS@/tst6-12a-bar.png
key enter
wait 3
shot @SHOTS@/tst6-12b-new-tab.png
# Step 13: Cmd-L, another address, Enter.
key l+cmd
wait 1
shot @SHOTS@/tst6-13a-bar-address.png
type file://@PAGES@/h.html
wait 1
key enter
wait 3
shot @SHOTS@/tst6-13b-same-tab.png
