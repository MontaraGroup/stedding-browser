# Stedding — Mac build with the dangling-pointer detector and DCHECKs on (Apple silicon).
#
# The Mac twin of win-checks.gn: the suites run on it before a push of code the Mac owns,
# and on the Mac's own code paths, which the Windows checked build never compiles
# (docs/AGENT-LOOP.md, "Order of evidence"). Build the three test targets with it
# (`tooling/dev build mac-checks unit_tests components_unittests stedding_browser_tests`)
# and run them with `STEDDING_TEST_OUT=mac-checks tooling/dev test all --no-build`, which
# adds
#
#   --enable-features=PartitionAllocBackupRefPtr,PartitionAllocDanglingPtr
#
# (docs/dangling_ptr.md in the checkout). Without that runtime flag the detector is
# compiled in and does nothing.
#
# What it is NOT: a shipping configuration, or one to measure with.
#
# As in win-checks.gn, is_debug = false and is_component_build = false stay exactly so: a
# debug or component build turns PartitionAlloc-Everywhere off, and BackupRefPtr silently
# with it. DCHECKs are on through dcheck_always_on, so the code is the optimised one the
# tests otherwise see.

target_os  = "mac"
target_cpu = "arm64"

is_debug           = false
is_component_build = false

dcheck_always_on               = true
enable_backup_ref_ptr_support  = true
enable_dangling_raw_ptr_checks = true

# No line tables: on the Mac they more than double the output directory, which the disk
# floor of tooling/build-chromium cannot spare beside out/release. A report's stack still
# names its functions from the binaries' symbol tables.
symbol_level       = 0
blink_symbol_level = 0
v8_symbol_level    = 0

# Google's remote execution backends are not available to us (see docs/ARCHITECTURE.md,
# "Build system"). Everything is built locally.
use_remoteexec = false

# No field-trial testing config (docs/features/privacy.md Q10), as in every Stedding
# configuration.
disable_fieldtrial_testing_config = true

# The codecs of release.gn, so the media paths the tests reach are the shipping ones
# (docs/decisions/0008-proprietary-codecs.md).
proprietary_codecs = true
ffmpeg_branding = "Chrome"
