# The demo's fixture, built through the product's own keys. Not recorded.
# record-demo.sh runs it on a fresh profile seeded with three Spaces (Work, Personal
# with its own session, Reading), with the fourteen pages of common.sh's DEMO_URLS and
# the capture params pin_tabs/4/folder_tabs/6: about a second after the window opens,
# the first four pages are the essentials and the next two a folder holding a nested one.
#
# Coordinates are window points of the 1400 x 880 window tooling/drive opens. GUESS
# marks a coordinate taken from the layout of earlier captures (essentials in two rows
# of two cards from y = 71, 56 apart; the Space title row under them; rows 46 apart;
# the Clear line under the pins). Confirm each from shots/setup-*.png
# (record-demo.sh layout) before a recording, and fix it here and in the scenes.
# Keys only where a key exists: a key needs no coordinate.
activate
wait 4
shot @SHOTS@/setup-00-start.png
# File the last four pages into the other Spaces, from the end: Cmd-9 is always the
# last row. Each move takes the window with it; Option-Cmd-Left twice is back in Work
# from either Space, since the ends do not wrap. (Ctrl-1 would do it too, but macOS
# takes the Ctrl-number keys once a second desktop exists.)
# LWN to Reading.
key 9+cmd
wait 1
key right+cmd+alt+shift
wait 2.5
key right+cmd+alt+shift
wait 2.5
key left+cmd+alt
wait 1.5
key left+cmd+alt
wait 2
# arXiv to Reading.
key 9+cmd
wait 1
key right+cmd+alt+shift
wait 2.5
key right+cmd+alt+shift
wait 2.5
key left+cmd+alt
wait 1.5
key left+cmd+alt
wait 2
# Wikipedia's HTTP cookie article to Personal, then Lobsters.
key 9+cmd
wait 1
key right+cmd+alt+shift
wait 2.5
key left+cmd+alt
wait 1.5
key left+cmd+alt
wait 2
key 9+cmd
wait 1
key right+cmd+alt+shift
wait 2.5
key left+cmd+alt
wait 1.5
key left+cmd+alt
wait 2
shot @SHOTS@/setup-01-filed.png
# Pin Django, then Python, in Work: up the sidebar from the last row (GitHub
# Trending, then the sample app). A new pin joins the end of the pinned run.
key 9+cmd
wait 1
key up+cmd+alt
wait 0.6
key up+cmd+alt
wait 0.6
key up+cmd+alt
wait 0.6
key d+cmd
wait 1.5
key 9+cmd
wait 1
key up+cmd+alt
wait 0.6
key up+cmd+alt
wait 0.6
key d+cmd
wait 1.5
shot @SHOTS@/setup-02-pinned.png
# Name the folders: a double click on a header renames it in place.
# GUESS: the outer folder's header at y = 371.
dblclick 150 371
wait 1
key a+cmd
type Docs
key enter
wait 1
# GUESS: the nested folder's header at y = 463.
dblclick 170 463
wait 1
key a+cmd
type Python
key enter
wait 1
# Leave the window on the GitHub essential, the page the recording opens on: the
# command bar finds the tab by its title (the first row is the typed text, the
# second the tab).
key t+cmd
wait 1
type stedding-browser
wait 1.5
key down
wait 0.5
key enter
wait 2.5
# GUESS: the rest point, on the sidebar's empty ground under the last row.
hover 150 720
wait 1
shot @SHOTS@/setup-03-open.png
# The rail, for its coordinates, and back.
key s+cmd
wait 2.5
shot @SHOTS@/setup-04-rail.png
key s+cmd
wait 2.5
shot @SHOTS@/setup-05-final.png
# tooling/drive quits Stedding here, the way the Dock's Quit does, so the session is
# written and the recorded run starts on this window.
