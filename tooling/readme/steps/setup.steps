# The demo's fixture, built through the product's own keys. Not recorded.
# record-demo.sh runs it on a fresh profile seeded with three Spaces (Work, Personal
# with its own session, Reading), with the fourteen pages of common.sh's DEMO_URLS and
# the capture params pin_tabs/4/folder_tabs/6: about a second after the window opens,
# the first four pages are the essentials and the next two a folder holding a nested one.
#
# Coordinates are window points of the 1400 x 880 window tooling/drive opens, read from
# the pictures of a layout run on the 0.3.0 beta 1 build (shots/setup-*.png): essentials in
# two rows of two cards from y = 71, 56 apart; the Space's title row under them; rows
# about 45 apart. A build that moves the sidebar's rows needs them read again, here
# and in the scenes.
# Keys only where a key exists: a key needs no coordinate.
activate
wait 4
shot @SHOTS@/setup-00-start.png
# File the last four pages into the other Spaces, from the end: Cmd-9 is always the
# last row. Each move takes the window with it; Option-Cmd-Left twice is back in Work
# from either Space, since the ends do not wrap. (Ctrl-1 would do it too, but macOS
# takes the Ctrl-number keys once a second desktop exists.)
# LWN to Reading.
key 9+cmd
wait 1
key right+cmd+alt+shift
wait 2.5
key right+cmd+alt+shift
wait 2.5
key left+cmd+alt
wait 1.5
key left+cmd+alt
wait 2
# Arch Linux to Reading, above LWN.
key 9+cmd
wait 1
key right+cmd+alt+shift
wait 2.5
key right+cmd+alt+shift
wait 2.5
key left+cmd+alt
wait 1.5
key left+cmd+alt
wait 2
# OpenStreetMap to Personal, then Lobsters.
key 9+cmd
wait 1
key right+cmd+alt+shift
wait 2.5
key left+cmd+alt
wait 1.5
key left+cmd+alt
wait 2
key 9+cmd
wait 1
key right+cmd+alt+shift
wait 2.5
key left+cmd+alt
wait 1.5
key left+cmd+alt
wait 2
shot @SHOTS@/setup-01-filed.png
# Pin Django, then PyPI, in Work: up the sidebar from the last row (GitHub
# Trending, then the sample app). A new pin joins the end of the pinned run.
key 9+cmd
wait 1
key up+cmd+alt
wait 0.6
key up+cmd+alt
wait 0.6
key up+cmd+alt
wait 0.6
key d+cmd
wait 1.5
key 9+cmd
wait 1
key up+cmd+alt
wait 0.6
key up+cmd+alt
wait 0.6
key d+cmd
wait 1.5
shot @SHOTS@/setup-02-pinned.png
# Name the folders: a double click on a folder's name renames it in place (a double
# click on the rest of the header opens or closes the folder, folders F4). The outer
# folder's name at (75, 369), the nested one's at (89, 457).
dblclick 75 369
wait 1
key a+cmd
type Docs
key enter
wait 1
dblclick 89 457
wait 1
key a+cmd
type Python
key enter
wait 1
# Leave the window on the GitHub essential, the page the recording opens on: the
# command bar finds the tab by its title (the first row is the typed text, the
# second the tab).
key t+cmd
wait 1
type stedding-browser
wait 1.5
key down
wait 0.5
key enter
wait 2.5
# The rest point, on the sidebar's empty ground under the last row.
hover 150 720
wait 1
shot @SHOTS@/setup-03-open.png
# The rail, for its coordinates, and back.
key s+cmd
wait 2.5
shot @SHOTS@/setup-04-rail.png
key s+cmd
wait 2.5
shot @SHOTS@/setup-05-final.png
# tooling/drive quits Stedding here, the way the Dock's Quit does, so the session is
# written and the recorded run starts on this window.
