# Before the first scene, and cut from the recording: the window comes forward, and
# every page a scene shows is loaded once, so no scene waits on the network.
# GUESS coordinates are setup.steps' (confirm them from shots/setup-03-open.png).
activate
wait 4
# GUESS: Django, the first pinned row, at y = 220.
glide 700 600 150 220 0.6
click 150 220
wait 3
# GUESS: Python, the second pinned row, at y = 266.
click 150 266
wait 3
# GUESS: the sample app on localhost, at y = 555.
click 150 555
wait 2.5
# The other Spaces' pages, found by title in the command bar.
key t+cmd
wait 1
type HTTP cookie
wait 1.5
key down
wait 0.5
key enter
wait 4
key t+cmd
wait 1
type LWN
wait 1.5
key down
wait 0.5
key enter
wait 3
# Back to Work by its chip (the first of three, at the sidebar's foot), then its
# GitHub essential. GUESS: the first essentials card at (93, 71).
click 146 848
wait 2.5
click 93 71
wait 3
# GUESS: the rest point, on the sidebar's empty ground (150, 720). Every glide after
# this one starts where the step before left the pointer.
glide 150 720 0.6
wait 2
